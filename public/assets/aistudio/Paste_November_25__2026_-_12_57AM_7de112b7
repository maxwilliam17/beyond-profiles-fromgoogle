        function systemNotificationsAvailable() {
            // WebView wrappers have no Notification API — this stays false there
            return typeof window.Notification !== 'undefined' && typeof window.isSecureContext !== 'undefined' && window.isSecureContext;
        }

        function notificationPermission() {
            if (!systemNotificationsAvailable()) return 'unsupported';
            return Notification.permission;
        }

        function updateNotifButton() {
            const btn = document.getElementById('notif-btn');
            if (!btn) return;
            const on = notifPrefs.inApp;
            btn.classList.toggle('off', !on);
