                .map((_, i) => `<span class="pin-dot ${i < pinState.buffer.length ? 'filled' : ''}"></span>`)
                .join('');

            // Locked state
            const keypad = document.getElementById('pin-keypad');
            const locked = pinState.lockedUntil > Date.now();
            keypad.classList.toggle('pin-keypad-locked', locked);

            if (!locked && !pinLockTimer) {
