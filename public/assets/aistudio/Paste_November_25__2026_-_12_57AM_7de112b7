        /* ---------- detection ---------- */
        function conversationSnapshot() {
            const out = [];
            if (!currentUser) return out;

            Object.keys(chatsData || {}).forEach(id => {
                if (!isMyChat(id)) return;
                const chat = chatsData[id] || {};
                const meta = chat.meta || {};
                const msgs = dmMessages(id);
                const last = msgs.length ? msgs[msgs.length - 1] : null;
                const lastAt = meta.lastAt || (last ? last.createdAt : 0);
                const senderId = meta.lastSenderId || (last ? last.senderId : null);
                const text = meta.lastMessage || (last ? last.text : '');
                out.push({
                    key: 'dm:' + id, kind: 'dm', id,
                    lastAt: lastAt || 0,
                    senderId,
                    text,
                    title: (getProfileById(getPartnerIdFromChatId(id)) || { name: 'New message' }).name
                });
            });

            Object.keys(groupsData || {}).forEach(id => {
                if (!isMyGroup(id)) return;
                const g = groupsData[id] || {};
                const meta = g.meta || {};
                const msgs = groupMessages(id);
                const last = msgs.length ? msgs[msgs.length - 1] : null;
                const lastAt = meta.lastAt || (last ? last.createdAt : 0);
                const senderId = meta.lastSenderId || (last ? last.senderId : null);
                const text = meta.lastMessage || (last ? last.text : '');
                const sender = senderId ? getProfileById(senderId) : null;
                out.push({
                    key: 'group:' + id, kind: 'group', id,
                    lastAt: lastAt || 0,
                    senderId,
                    text,
                    title: g.name || 'Group',
                    senderName: sender ? sender.name : (last ? last.senderName : 'Someone')
                });
            });

            return out;
        }

        function isConversationOnScreen(kind, id) {
            return !!(messengerOpen && activeConvo && activeConvo.kind === kind && activeConvo.id === id && !document.hidden);
        }

        function scanForNewMessages() {
            if (!currentUser) return;
            const snapshot = conversationSnapshot();

            // First pass after login just records what is already there — no spam
            if (!notifBaselineDone) {
                snapshot.forEach(c => { knownLastAt[c.key] = c.lastAt; });
                notifBaselineDone = true;
                return;
            }

            snapshot.forEach(convo => {
                const previous = knownLastAt[convo.key];
                knownLastAt[convo.key] = Math.max(convo.lastAt || 0, previous || 0);

                // A conversation we already knew about needs to have moved on;
                // a brand-new chat (previous === undefined) with a message is worth alerting.
                if (previous !== undefined && (!convo.lastAt || convo.lastAt <= previous)) return;
                if (!convo.senderId || convo.senderId === currentUser.id) return; // my own message
                if (!notifPrefs.inApp) return;
                if (isConversationOnScreen(convo.kind, convo.id)) return; // user is reading it

                const text = convo.text || 'New message';
                const heading = convo.kind === 'group'
                    ? `${convo.title} · ${convo.senderName}`
                    : convo.title;

                const avatarHtml = convo.kind === 'group'
                    ? `<div class="notif-avatar">${groupAvatarInner(getGroupById(convo.id))}</div>`
                    : `<div class="notif-avatar">${profileAvatarInner(getProfileById(convo.senderId))}</div>`;

                showToast({
                    title: heading,
                    text,
                    avatarHtml,
                    onClick: () => {
                        if (!messengerOpen) openMessages();
                        openConversation(convo.kind, convo.id);
                    }
                });

                playNotificationSound();
                vibrateAlert();

                if (document.hidden) {
                    showSystemNotification(heading, text, `${convo.kind}:${convo.id}`);
                }
            });
        }

        /* ---------- deep link from a notification ---------- */
        function readPendingOpenFromUrl() {
            try {
                const hash = window.location.hash || '';
                const m = hash.match(/open=(dm|group):([^&]+)/);
                if (m) { pendingOpenTarget = { kind: m[1], id: decodeURIComponent(m[2]) }; }
            } catch (e) {}
        }

        function tryOpenPendingTarget() {
            if (!pendingOpenTarget || !currentUser) return;
            const target = pendingOpenTarget;
            pendingOpenTarget = null;
            if (!convoNode(target.kind, target.id)) return;
            if (target.kind === 'group' && !isMyGroup(target.id)) return;
            openMessages();
            openConversation(target.kind, target.id);
        }

        /* ---------- service worker / web push ---------- */
        function serviceWorkerSupported() {
            return 'serviceWorker' in navigator &&
                   (location.protocol === 'https:' || location.hostname === 'localhost' || location.hostname === '127.0.0.1');
        }

        async function registerServiceWorker() {
            if (!serviceWorkerSupported()) return null;
            try {
                const reg = await navigator.serviceWorker.register('sw.js');
                return reg;
            } catch (e) {
                console.warn('Service worker registration failed:', e);
                return null;
            }
        }

        function urlBase64ToUint8Array(base64String) {
            const padding = '='.repeat((4 - base64String.length % 4) % 4);
            const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
            const raw = atob(base64);
            const out = new Uint8Array(raw.length);
            for (let i = 0; i < raw.length; i++) out[i] = raw.charCodeAt(i);
            return out;
        }

        // Saves this device's push subscription so a server can reach it later
        async function registerPushSubscription() {
            if (!VAPID_PUBLIC_KEY) return;                 // not configured yet
            if (!serviceWorkerSupported() || !('PushManager' in window)) return;
            if (!currentUser || Notification.permission !== 'granted') return;

            try {
                const reg = await navigator.serviceWorker.getRegistration();
                if (!reg) return;
                let sub = await reg.pushManager.getSubscription();
                if (!sub) {
                    sub = await reg.pushManager.subscribe({
                        userVisibleOnly: true,
                        applicationServerKey: urlBase64ToUint8Array(VAPID_PUBLIC_KEY)
                    });
                }
                const payload = JSON.parse(JSON.stringify(sub));
                payload.profileId = currentUser.id;
                payload.profileName = currentUser.name;
                payload.savedAt = Date.now();
                await db.ref(`pushSubs/${currentUser.id}/${encodeURIComponent(sub.endpoint).slice(-40)}`).set(payload);
            } catch (e) {
                console.warn('Push subscription failed:', e);
            }
        }

        /* ============================================================
           CONVERSATIONS — direct messages + WhatsApp-style groups
           ============================================================ */

        /* ---------- ids, lookups, membership ---------- */
        function makeChatId(a, b) {
            return [a, b].sort().join('__');
        }

        function getPartnerIdFromChatId(chatId) {
            const parts = String(chatId).split('__');
            return parts.find(p => p !== currentUser.id) || parts[0];
        }

        function getProfileById(id) {
            return profiles.find(p => p.id === id) || null;
        }

        function getGroupById(id) {
            const g = groupsData[id];
            return g ? Object.assign({ id }, g) : null;
        }

        function isMyChat(chatId) {
            if (!currentUser) return false;
            const chat = chatsData[chatId];
            if (chat && chat.meta && chat.meta.participants && chat.meta.participants[currentUser.id]) return true;
            return String(chatId).split('__').includes(currentUser.id);
        }

        function isMyGroup(groupId) {
            if (!currentUser) return false;
            const g = groupsData[groupId];
            return !!(g && g.members && g.members[currentUser.id]);
        }

        function groupMemberIds(group) {
            return Object.keys((group && group.members) || {});
        }

        function groupMemberProfiles(group) {
            return groupMemberIds(group).map(getProfileById).filter(Boolean);
        }

        function groupMemberLabel(group) {
            const members = groupMemberProfiles(group);
            const names = members.filter(p => !currentUser || p.id !== currentUser.id).map(p => p.name);
            if (names.length === 0) return 'Just you';
            if (names.length <= 2) return names.join(', ');
            return `${names.slice(0, 2).join(', ')} +${names.length - 2}`;
        }

        /* ---------- message collections ---------- */
        function mapToSortedArray(obj) {
            if (!obj) return [];
            return Object.entries(obj)
                .map(([id, m]) => Object.assign({ id }, m))
                .sort((a, b) => (a.createdAt || 0) - (b.createdAt || 0));
        }

        function dmMessages(chatId) {
            const chat = chatsData[chatId];
            return mapToSortedArray(chat && chat.messages);
        }

        function groupMessages(groupId) {
            const g = groupsData[groupId];
            return mapToSortedArray(g && g.messages);
        }

        function convoMessages(kind, id) {
            return kind === 'group' ? groupMessages(id) : dmMessages(id);
        }

        function convoNode(kind, id) {
            return kind === 'group' ? groupsData[id] : chatsData[id];
        }

        function convoPath(kind, id) {
            return (kind === 'group' ? 'groups/' : 'chats/') + id;
        }

        function convoRef(kind, id) {
            return db.ref(convoPath(kind, id));
        }

        /* ---------- read state ---------- */
        function readTs(kind, id, uid) {
            const node = convoNode(kind, id);
            return (node && node.reads && node.reads[uid]) || 0;
        }

        function unreadFor(kind, id) {
            if (!currentUser) return 0;
            const mine = readTs(kind, id, currentUser.id);
            return convoMessages(kind, id).filter(m => m.senderId !== currentUser.id && (m.createdAt || 0) > mine).length;
        }

        // Direct chat: when did the other person last open the conversation?
        function partnerReadTs(chatId) {
            if (!currentUser) return 0;
            const chat = chatsData[chatId];
            if (!chat || !chat.reads) return 0;
            let max = 0;
            Object.keys(chat.reads).forEach(uid => {
                if (uid === currentUser.id) return;
                const ts = chat.reads[uid] || 0;
                if (ts > max) max = ts;
            });
            return max;
        }

        // Group: how many of the other members have read this message?
        function groupReadInfo(groupId, message) {
            const g = groupsData[groupId];
            if (!g || !message) return { read: 0, others: 0 };
            const others = groupMemberIds(g).filter(id => id !== (currentUser && currentUser.id));
            const reads = g.reads || {};
            const stamp = message.createdAt || 0;
            const read = others.filter(id => (reads[id] || 0) >= stamp).length;
            return { read, others: others.length };
        }

        /**
         * Receipt for one of my messages.
         * state: 'sent'  -> nobody has opened it yet
         *        'some'  -> some group members have read it
         *        'all'   -> everyone has read it
         */
        function receiptState(kind, id, message) {
            if (!message) return { state: 'sent', label: 'Sent' };
            if (kind === 'group') {
                const info = groupReadInfo(id, message);
                if (info.others === 0) return { state: 'sent', label: 'Sent' };
                if (info.read === 0) return { state: 'sent', label: 'Sent' };
                if (info.read === info.others) {
                    return { state: 'all', label: info.others > 1 ? 'Seen by all' : 'Seen' };
                }
                return { state: 'some', label: `Seen by ${info.read}/${info.others}` };
            }
            const ts = partnerReadTs(id);
            const seen = (message.createdAt || 0) <= ts;
            return seen
                ? { state: 'all', label: 'Seen' + (ts ? ' · ' + formatChatTime(ts) : '') }
                : { state: 'sent', label: 'Sent' };
        }

        function totalUnread() {
            if (!currentUser) return 0;
            let total = 0;
            Object.keys(chatsData || {}).forEach(id => { if (isMyChat(id)) total += unreadFor('dm', id); });
            Object.keys(groupsData || {}).forEach(id => { if (isMyGroup(id)) total += unreadFor('group', id); });
            return total;
        }

        function myConversationCount() {
            const dms = Object.keys(chatsData || {}).filter(isMyChat).length;
            const groups = Object.keys(groupsData || {}).filter(isMyGroup).length;
            return dms + groups;
        }

        /* ---------- Firebase listeners ---------- */
        function startChatsListener() {
            if (!currentUser) return;
            stopChatsListener();

            chatsRef = db.ref('chats');
            chatsRef.on('value', snapshot => {
                chatsData = snapshot.val() || {};
                onConversationDataChanged();
            }, error => console.error('Chats listener error:', error));

            groupsRef = db.ref('groups');
            groupsRef.on('value', snapshot => {
                groupsData = snapshot.val() || {};
                onConversationDataChanged();
            }, error => console.error('Groups listener error:', error));
        }

        function onConversationDataChanged() {
            updateUnreadBadges();
            scanForNewMessages();
            if (messengerOpen && !activeConvo) tryOpenPendingTarget();
            if (!messengerOpen) return;
            renderChatList();
            if (activeConvo) {
                const kind = activeConvo.kind, id = activeConvo.id;
                // Deleted conversation, or removed from the group -> back to the list
                if (!convoNode(kind, id) || (kind === 'group' && !isMyGroup(id))) {
                    closeGroupInfo();
                    backToChatList();
                    return;
                }
                renderMessages();
                markConversationRead();
                if (kind === 'group' && groupInfoOpen) renderGroupInfo();
            }
        }

        function stopChatsListener() {
            if (chatsRef) { chatsRef.off(); chatsRef = null; }
            if (groupsRef) { groupsRef.off(); groupsRef = null; }
            chatsData = {};
            groupsData = {};
        }

        function updateUnreadBadges() {
            if (!currentUser) return;
            const unread = totalUnread();
            const convos = myConversationCount();

            const badge = document.getElementById('msg-badge');
            if (badge) {
                if (unread > 0) {
                    badge.textContent = unread > 99 ? '99+' : unread;
                    badge.classList.remove('hidden');
                    badge.classList.add('flex');
                } else {
                    badge.classList.add('hidden');
                    badge.classList.remove('flex');
                }
            }

            const tileBadge = document.getElementById('tile-msg-badge');
            if (tileBadge) {
                if (unread > 0) {
                    tileBadge.textContent = unread > 99 ? '99+' : unread;
                    tileBadge.classList.remove('hidden');
                    tileBadge.classList.add('flex');
                } else {
                    tileBadge.classList.add('hidden');
                    tileBadge.classList.remove('flex');
                }
            }

            // Tab / app-switcher badge in the title
            document.title = unread > 0
                ? `(${unread > 99 ? '99+' : unread}) Beyond Profiles`
                : 'Beyond Profiles';

            const countEl = document.getElementById('messages-count');
            if (countEl) {
                if (unread > 0) {
                    countEl.textContent = `${unread} unread`;
                    countEl.classList.add('text-emerald-300');
                    countEl.classList.remove('text-white/50');
                } else {
                    countEl.textContent = convos === 0 ? 'No chats yet' : `${convos} chat${convos === 1 ? '' : 's'}`;
                    countEl.classList.remove('text-emerald-300');
                    countEl.classList.add('text-white/50');
                }
            }
        }

        /* ---------- Viewport height tracking ---------- */
        function updateAppHeight() {
            const vv = window.visualViewport;
            const h = vv ? vv.height : window.innerHeight;
            const top = vv ? vv.offsetTop : 0;
            document.documentElement.style.setProperty('--app-height', Math.round(h) + 'px');
            document.documentElement.style.setProperty('--vv-top', Math.round(top) + 'px');
            if (messengerOpen && stickToBottom) scrollMessagesToBottom();
        }

        function installViewportTracking() {
            updateAppHeight();
            window.addEventListener('resize', updateAppHeight);
            window.addEventListener('orientationchange', () => setTimeout(updateAppHeight, 250));
            if (window.visualViewport) {
                window.visualViewport.addEventListener('resize', updateAppHeight);
                window.visualViewport.addEventListener('scroll', updateAppHeight);
            }
            setTimeout(updateAppHeight, 300);
            setTimeout(updateAppHeight, 1200);
        }

        /* ---------- Panel open / close ---------- */
        function openMessages() {
            if (!currentUser) return;
            messengerOpen = true;
            updateAppHeight();
            const panel = document.getElementById('messenger-panel');
            panel.classList.add('open');
            panel.classList.remove('opacity-0', 'pointer-events-none');
            panel.classList.add('opacity-100');
            document.body.classList.add('app-no-scroll');
            if (!chatsRef) startChatsListener();
            renderChatList();
            updateUnreadBadges();
            syncConversationVisibility();
        }

        function closeMessenger(silent) {
            messengerOpen = false;
            const panel = document.getElementById('messenger-panel');
            if (panel) {
                panel.classList.remove('open');
                panel.classList.add('opacity-0', 'pointer-events-none');
                panel.classList.remove('opacity-100', 'chat-open');
            }
            document.body.classList.remove('app-no-scroll');
            activeConvo = null;
            activeChatId = null;
            activePartnerId = null;
            hideEmojiPicker();
            hideNewChatSheet();
            closeCreateGroup();
            closeGroupInfo();
        }

        function syncConversationVisibility() {
            const hasChat = !!activeConvo;
            const pane = document.getElementById('conversation-pane');
            const header = document.getElementById('conversation-header');
            const area = document.getElementById('messages-area');
            const composer = document.getElementById('composer');
            const placeholder = document.getElementById('chat-placeholder');
            const infoBtn = document.getElementById('group-info-btn');

            header.classList.toggle('shown', hasChat);
            area.classList.toggle('shown', hasChat);
            composer.classList.toggle('shown', hasChat);
            pane.classList.toggle('chat-selected', hasChat);
            if (placeholder) placeholder.classList.toggle('is-hidden', hasChat);

            if (infoBtn) {
                const isGroup = !!(activeConvo && activeConvo.kind === 'group');
                infoBtn.classList.toggle('hidden', !isGroup);
                infoBtn.classList.toggle('flex', isGroup);
            }

            const callBtn = document.getElementById('voice-call-btn');
            if (callBtn) {
                const isGroup = !!(activeConvo && activeConvo.kind === 'group');
                callBtn.classList.toggle('hidden', isGroup);
                callBtn.classList.toggle('flex', !isGroup && hasChat);
            }

            const videoCallBtn = document.getElementById('video-call-btn');
            if (videoCallBtn) {
                const isGroup = !!(activeConvo && activeConvo.kind === 'group');
                videoCallBtn.classList.toggle('hidden', isGroup);
                videoCallBtn.classList.toggle('flex', !isGroup && hasChat);
            }
        }

        function backToChatList() {
            document.getElementById('messenger-panel').classList.remove('chat-open');
            activeConvo = null;
            activeChatId = null;
            activePartnerId = null;
            syncConversationVisibility();
            renderChatList();
        }

        /* ---------- New message sheet ---------- */
        function openNewChatSheet() {
            if (!currentUser) return;
            const others = profiles.filter(p => p.id !== currentUser.id);
            const list = document.getElementById('new-chat-list');

            if (others.length === 0) {
                list.innerHTML = `
                    <div class="px-6 py-8 text-center">
                        <p class="text-white/50 text-sm">There are no other profiles yet.</p>
                        <p class="text-white/25 text-xs mt-2">Add another profile from the profile screen to start chatting.</p>
                    </div>`;
            } else {
                list.innerHTML = others.map(p => `
                    <div class="chat-item member-row">
                        <div onclick="startChatFromSheet('${p.id}')" class="flex items-center gap-3 flex-1 min-w-0" style="cursor:pointer">
                            <div class="member-avatar ${p.color}">
                                <img src="${avatarSrcFor(p)}" alt="">
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="member-name truncate">${escapeHtml(p.name)}${p.isKid ? ' <span class="member-meta">KIDS</span>' : ''}</p>
                                <p class="member-meta">Send a message</p>
                            </div>
                        </div>
                        <button onclick="event.stopPropagation(); startCallFromSheet('${p.id}', false)" class="member-call-btn" aria-label="Voice call ${escapeHtml(p.name)}" title="Voice call">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 004.11 2h3a2 2 0 012 1.72c.13.96.36 1.9.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0122 16.92z"/>
                            </svg>
                        </button>
                        <button onclick="event.stopPropagation(); startCallFromSheet('${p.id}', true)" class="member-video-btn" aria-label="Video call ${escapeHtml(p.name)}" title="Video call">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                            </svg>
                        </button>
                    </div>
                `).join('');
            }

            const modal = document.getElementById('new-chat-modal');
            modal.classList.remove('opacity-0', 'pointer-events-none');
            modal.classList.add('opacity-100');
        }

        function hideNewChatSheet() {
            const modal = document.getElementById('new-chat-modal');
            if (!modal) return;
            modal.classList.add('opacity-0', 'pointer-events-none');
            modal.classList.remove('opacity-100');
        }

        function startChatFromSheet(partnerId) {
            hideNewChatSheet();
            openConversation('dm', makeChatId(currentUser.id, partnerId));
            setTimeout(() => {
                const input = document.getElementById('message-input');
                if (input && window.innerWidth >= 768) input.focus();
            }, 250);
        }

        /* ---------- Group avatars ---------- */
        function groupInitials(name) {
            const words = String(name || 'Group').trim().split(/\s+/).filter(Boolean);
            const letters = words.slice(0, 2).map(w => w[0]).join('');
            return (letters || 'G').toUpperCase();
        }

        function groupGradient(key) {
            const palette = [
                ['#6366f1', '#8b5cf6'], ['#ec4899', '#f43f5e'], ['#f59e0b', '#ef4444'],
                ['#10b981', '#0ea5e9'], ['#8b5cf6', '#6366f1'], ['#0ea5e9', '#14b8a6'],
                ['#ef4444', '#f97316'], ['#14b8a6', '#22c55e']
            ];
            let hash = 0;
            const s = String(key || 'group');
            for (let i = 0; i < s.length; i++) hash = (hash * 31 + s.charCodeAt(i)) % 9973;
            return palette[hash % palette.length];
        }

        // Inner content for a group avatar (photo if set, otherwise initials)
        function groupAvatarInner(group) {
            if (!group) return '';
            if (group.photo) {
                return `<img src="${group.photo}" alt="" style="width:100%;height:100%;object-fit:cover;display:block">`;
            }
            const colors = groupGradient(group.id || group.name);
            return `<div class="group-avatar-fallback" style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;
                        background:linear-gradient(135deg,${colors[0]},${colors[1]});color:#fff;font-weight:700;font-size:15px;letter-spacing:0.02em">
                        ${escapeHtml(groupInitials(group.name))}
                    </div>`;
        }

        function groupAvatarHtml(group, sizeClass) {
            return `<div class="group-avatar ${sizeClass} rounded-xl overflow-hidden flex-shrink-0">${groupAvatarInner(group)}</div>`;
        }

        function profileAvatarInner(profile) {
            return `<img src="${avatarSrcFor(profile)}" alt="" style="width:100%;height:100%;object-fit:cover;display:block">`;
        }

        /* ---------- Merged conversation list ---------- */
        function conversationEntries() {
            if (!currentUser) return [];
            const entries = [];

            // Direct messages
            Object.keys(chatsData || {}).forEach(id => {
                if (!isMyChat(id)) return;
                const chat = chatsData[id] || {};
                const meta = chat.meta || {};
                const partner = getProfileById(getPartnerIdFromChatId(id));
                const msgs = dmMessages(id);
                const last = msgs.length ? msgs[msgs.length - 1] : null;
                const lastAt = meta.lastAt || (last ? last.createdAt : 0);
                const lastSenderId = meta.lastSenderId || (last ? last.senderId : null);
                const lastMessage = meta.lastMessage || (last ? last.text : '');

                let receipt = null;
                if (lastMessage && lastSenderId === currentUser.id) {
                    receipt = (lastAt <= partnerReadTs(id)) ? 'seen' : 'sent';
                }

                entries.push({
                    kind: 'dm',
                    id,
                    title: partner ? partner.name : 'Deleted profile',
                    avatar: `<div class="flex-shrink-0 rounded-xl overflow-hidden ${partner ? partner.color : 'bg-gray-600'}" style="width:48px;height:48px">${profileAvatarInner(partner)}</div>`,
                    preview: lastMessage
                        ? (lastSenderId === currentUser.id ? `You: ${lastMessage}` : lastMessage)
                        : 'No messages yet',
                    lastAt,
                    unread: unreadFor('dm', id),
                    receipt
                });
            });

            // Groups
            Object.keys(groupsData || {}).forEach(id => {
                if (!isMyGroup(id)) return;
                const g = groupsData[id] || {};
                const meta = g.meta || {};
                const msgs = groupMessages(id);
                const last = msgs.length ? msgs[msgs.length - 1] : null;
                const lastAt = meta.lastAt || (last ? last.createdAt : 0) || g.createdAt || 0;
                const lastSenderId = meta.lastSenderId || (last ? last.senderId : null);
                const lastMessage = meta.lastMessage || (last ? last.text : '');
                const count = groupMemberIds(g).length;
                const senderProfile = lastSenderId ? getProfileById(lastSenderId) : null;

                let preview;
                if (lastMessage) {
                    preview = lastSenderId === currentUser.id
                        ? `You: ${lastMessage}`
                        : `${senderProfile ? senderProfile.name : (last ? last.senderName : 'Someone')}: ${lastMessage}`;
                } else {
                    preview = `${count} member${count === 1 ? '' : 's'} · say hi 👋`;
                }

                let receipt = null;
                if (lastMessage && lastSenderId === currentUser.id && last) {
                    const info = groupReadInfo(id, last);
                    receipt = info.read === 0 ? 'sent' : (info.read === info.others ? 'seen' : 'some');
                }

                entries.push({
                    kind: 'group',
                    id,
                    title: g.name || 'Group',
                    avatar: groupAvatarHtml(Object.assign({ id }, g), ''),
                    avatarStyle: 'width:48px;height:48px;flex:0 0 48px',
                    preview,
                    lastAt,
                    unread: unreadFor('group', id),
                    receipt,
                    isGroup: true
                });
            });

            return entries.sort((a, b) => (b.lastAt || 0) - (a.lastAt || 0));
        }

        function renderChatList() {
            const list = document.getElementById('chat-list');
            if (!list || !currentUser) return;

            const search = (document.getElementById('chat-search')?.value || '').trim().toLowerCase();
            const all = conversationEntries();
            const filtered = search ? all.filter(c => c.title.toLowerCase().includes(search)) : all;

            const chattedPartnerIds = new Set(
                all.filter(c => c.kind === 'dm').map(c => getPartnerIdFromChatId(c.id))
            );
            const startable = profiles
                .filter(p => p.id !== currentUser.id && !chattedPartnerIds.has(p.id))
                .filter(p => !search || p.name.toLowerCase().includes(search));

            let html = '';

            if (filtered.length === 0 && startable.length === 0) {
                html = search
                    ? `<div class="text-center px-6 py-12"><p class="text-white/40 text-sm">No chats match “${escapeHtml(search)}”.</p></div>`
                    : `<div class="text-center px-6 py-12">
                           <p class="text-white/40 text-sm">No conversations yet.</p>
                           <p class="text-white/25 text-xs mt-2">Tap + to start a chat or create a group.</p>
                       </div>`;
                list.innerHTML = html;
                return;
            }

            html += filtered.map(entry => {
                const active = activeConvo && activeConvo.kind === entry.kind && activeConvo.id === entry.id;
                const time = entry.lastAt ? formatChatTime(entry.lastAt) : '';
                const receiptTag = entry.receipt
                    ? `<span class="flex-shrink-0 ${entry.receipt === 'seen' ? 'text-emerald-300/80' : entry.receipt === 'some' ? 'text-sky-300/70' : 'text-white/30'}">
                           · ${entry.receipt === 'seen' ? 'Seen' : entry.receipt === 'some' ? 'Partly seen' : 'Sent'}
                       </span>`
                    : '';
                const groupTag = entry.isGroup
                    ? `<span class="text-white/30 text-[10px] flex-shrink-0">GROUP</span>`
                    : '';

                return `
                    <div onclick="openConversation('${entry.kind}', '${entry.id}')" class="chat-item ${active ? 'active' : ''}">
                        ${entry.avatar}
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center justify-between gap-2">
                                <p class="text-white text-sm font-semibold truncate flex items-center gap-1.5">${escapeHtml(entry.title)}${groupTag}</p>
                                <span class="text-white/30 text-[11px] flex-shrink-0">${time}</span>
                            </div>
                            <div class="flex items-center justify-between gap-2 mt-0.5">
                                <p class="text-white/45 text-xs truncate flex items-center min-w-0">
                                    <span class="truncate">${escapeHtml(entry.preview)}</span>${receiptTag}
                                </p>
                                ${entry.unread > 0 ? `<span class="flex-shrink-0 min-w-[18px] h-[18px] px-1 rounded-full bg-indigo-500 text-white text-[10px] font-bold flex items-center justify-center">${entry.unread > 99 ? '99+' : entry.unread}</span>` : ''}
                            </div>
                        </div>
                    </div>`;
            }).join('');

            if (startable.length > 0) {
                html += `
                    <div class="info-label" style="padding-top:16px">Start a new chat</div>
                    ${startable.map(p => `
                        <div onclick="startChatFromSheet('${p.id}')" class="chat-item member-row">
                            <div class="member-avatar ${p.color}">${profileAvatarInner(p)}</div>
                            <div class="flex-1 min-w-0">
                                <p class="member-name truncate">${escapeHtml(p.name)}${p.isKid ? ' <span class="member-meta">KIDS</span>' : ''}</p>
                                <p class="member-meta">Tap to say hi 👋</p>
                            </div>
                            <svg style="width:18px;height:18px;color:rgba(255,255,255,0.2)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                            </svg>
                        </div>
                    `).join('')}`;
            }

            list.innerHTML = html;
        }

        /* ---------- Open a conversation ---------- */
        function openChatWith(partnerId) {
            if (!currentUser) return;
            openConversation('dm', makeChatId(currentUser.id, partnerId));
        }

        // Kept for backwards compatibility with existing links/tests
        function openChat(chatId) {
            openConversation('dm', chatId);
        }

        function openConversation(kind, id) {
            if (!currentUser) return;
            if (!convoNode(kind, id)) {
                // Not loaded yet -> make sure it exists locally as an empty shell
                if (kind === 'group') { renderChatList(); return; }
            }

            activeConvo = { kind, id };
            activeChatId = kind === 'dm' ? id : null;
            activePartnerId = kind === 'dm' ? getPartnerIdFromChatId(id) : null;

            const avatarEl = document.getElementById('chat-partner-avatar');
            const nameEl = document.getElementById('chat-partner-name');
            const statusEl = document.getElementById('chat-partner-status');

            if (kind === 'group') {
                const g = getGroupById(id);
                const count = g ? groupMemberIds(g).length : 0;
                avatarEl.className = 'rounded-xl overflow-hidden flex-shrink-0';
                avatarEl.style.cssText = 'width:40px;height:40px;flex:0 0 40px';
                avatarEl.innerHTML = g ? groupAvatarInner(g) : '';
                nameEl.textContent = g ? (g.name || 'Group') : 'Group';
                statusEl.textContent = `${count} member${count === 1 ? '' : 's'} · ${g ? groupMemberLabel(g) : ''}`;
            } else {
                const partner = getProfileById(activePartnerId);
                avatarEl.className = `w-10 h-10 rounded-xl ${partner ? partner.color : 'bg-gray-600'} overflow-hidden flex-shrink-0`;
                avatarEl.style.cssText = 'width:40px;height:40px;flex:0 0 40px';
                avatarEl.innerHTML = profileAvatarInner(partner);
                nameEl.textContent = partner ? partner.name : 'Deleted profile';
                statusEl.textContent = partner
                    ? (partner.isKid ? 'Kids profile' : 'Available')
                    : 'This profile was removed';
            }

            syncConversationVisibility();
            document.getElementById('messenger-panel').classList.add('chat-open');
            updateAppHeight();

            renderChatList();
            stickToBottom = true;
            renderMessages();
            markConversationRead();
            // Don't alert for what we just looked at
            knownLastAt[kind + ':' + id] = Math.max(
                knownLastAt[kind + ':' + id] || 0,
                (convoMessages(kind, id).slice(-1)[0] || {}).createdAt || 0
            );

            const input = document.getElementById('message-input');
            if (window.innerWidth >= 768) input.focus();
        }

        /* ---------- Messages rendering ---------- */
        function renderMessages() {
            const area = document.getElementById('messages-area');
            if (!area || !activeConvo || !currentUser) return;

            const kind = activeConvo.kind, id = activeConvo.id;
            const msgs = convoMessages(kind, id);
            const me = currentUser.id;
            const isGroup = kind === 'group';

            if (msgs.length === 0) {
                const g = isGroup ? getGroupById(id) : null;
                const partner = !isGroup ? getProfileById(activePartnerId) : null;
                const title = isGroup ? (g ? g.name : 'Group') : (partner ? partner.name : 'This profile');
                area.innerHTML = `
                    <div class="empty-chat">
                        <div style="width:64px;height:64px;border-radius:16px;overflow:hidden;margin-bottom:12px;opacity:0.85">
                            ${isGroup ? (g ? groupAvatarInner(g) : '') : profileAvatarInner(partner)}
                        </div>
                        <p class="text-white/60 text-sm font-medium">${escapeHtml(title)}</p>
                        <p class="text-white/30 text-xs mt-1">${isGroup
                            ? 'No messages yet — start the conversation 👋'
                            : 'No messages yet — send the first one 👋'}</p>
                    </div>`;
                return;
            }

            const myMessages = msgs.filter(m => m.senderId === me);
            const lastOwnId = myMessages.length ? myMessages[myMessages.length - 1].id : null;

            let lastDay = '';
            let prevSenderId = null;

            area.innerHTML = msgs.map(m => {
                const mine = m.senderId === me;
                const sender = getProfileById(m.senderId) || { name: m.senderName || 'Unknown', color: 'bg-slate-600' };

                let divider = '';
                const day = formatDayLabel(m.createdAt);
                if (day !== lastDay) {
                    lastDay = day;
                    divider = `<div class="day-divider flex justify-center my-4"><span class="text-[11px] text-white/35 bg-white/5 px-3 py-1 rounded-full">${day}</span></div>`;
                }

                // In groups, show who wrote each run of messages
                const showSender = isGroup && !mine && m.senderId !== prevSenderId;
                prevSenderId = m.senderId;

                const bubbleClass = mine ? 'bubble-me' : 'bubble-them';
                const align = mine ? 'justify-end' : 'justify-start';
                const time = formatClockTime(m.createdAt);
                const receipt = mine ? receiptState(kind, id, m) : null;

                const avatar = mine ? '' : `
                    <div class="rounded-lg overflow-hidden flex-shrink-0 mb-1 ${sender.color || 'bg-slate-600'}"
                         style="width:28px;height:28px;flex:0 0 28px;visibility:${isGroup && !showSender ? 'hidden' : 'visible'}">
                        ${profileAvatarInner(sender)}
                    </div>`;

                const senderLabel = showSender
                    ? `<div class="sender-label">${escapeHtml(sender.name)}</div>`
                    : '';

                const ticks = (!mine || !receipt) ? '' : (receipt.state === 'all' ? `
                    <svg class="w-3.5 h-3.5 inline-block ml-1 -mt-0.5 text-emerald-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M1.5 12.5l4 4L14 8"/>
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9.5 12.5l4 4L22 8"/>
                    </svg>` : receipt.state === 'some' ? `
                    <svg class="w-3.5 h-3.5 inline-block ml-1 -mt-0.5 text-sky-300/80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M1.5 12.5l4 4L14 8"/>
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9.5 12.5l4 4L22 8"/>
                    </svg>` : `
                    <svg class="w-3.5 h-3.5 inline-block ml-1 -mt-0.5 text-white/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 12.5l5 5L20 7"/>
                    </svg>`);

                const delBtn = mine ? `
                    <button onclick="deleteMessage('${m.id}')" title="Delete message" aria-label="Delete message"
                        class="msg-del self-center p-1.5 rounded-lg hover:bg-white/10 text-white/40 hover:text-red-400 transition-colors">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                        </svg>
                    </button>` : '';

                // Receipt line under my most recent message
                const showReceiptLine = !!mine && m.id === lastOwnId;
                let receiptLine = '';
                if (showReceiptLine && receipt) {
                    const receiptColor = receipt.state === 'all' ? 'text-emerald-300/90'
                        : receipt.state === 'some' ? 'text-sky-300/80' : 'text-white/35';
                    const receiptIcon = receipt.state === 'sent'
                        ? `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 12.5l5 5L20 7"/></svg>`
                        : `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M1.5 12.5l4 4L14 8"/><path stroke-linecap="round" stroke-linejoin="round" d="M9.5 12.5l4 4L22 8"/></svg>`;
                    receiptLine = `
                        <div class="receipt-row mine flex justify-end">
                            <span class="${receiptColor}">${receiptIcon}${escapeHtml(receipt.label)}</span>
                        </div>`;
                }

                return divider + `
                    <div>
                        ${senderLabel}
                        <div class="msg-row ${mine ? 'mine' : ''} flex ${align} items-end gap-2 ${mine && showReceiptLine ? 'mb-0' : 'mb-2'}">
                            ${mine ? delBtn : avatar}
                            <div class="bubble ${bubbleClass}"><span class="bubble-text">${escapeHtml(m.text || '')}</span><span class="bubble-meta">${time}${ticks}</span></div>
                        </div>
                    </div>` + receiptLine;
            }).join('');

            if (stickToBottom) scrollMessagesToBottom();
        }

        function scrollMessagesToBottom() {
            const area = document.getElementById('messages-area');
            if (!area) return;
            requestAnimationFrame(() => { area.scrollTop = area.scrollHeight; });
        }

        // Track "is the user near the bottom" so incoming messages don't yank the view
        document.addEventListener('DOMContentLoaded', () => {
            const area = document.getElementById('messages-area');
            if (!area) return;
            area.addEventListener('scroll', () => {
                const distance = area.scrollHeight - area.scrollTop - area.clientHeight;
                stickToBottom = distance < 80;
            });
        });

        /* ---------- Sending ---------- */
        function autoResizeInput(el) {
            el.style.height = 'auto';
            el.style.height = Math.min(el.scrollHeight, 120) + 'px';
        }

        function handleMessageKey(e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendMessage();
            }
        }

        async function sendMessage() {
            if (!currentUser || !activeConvo) return;
            const input = document.getElementById('message-input');
            const text = input.value.trim();
            if (!text) return;

            const kind = activeConvo.kind, id = activeConvo.id;
            input.value = '';
            autoResizeInput(input);
            hideEmojiPicker();
            stickToBottom = true;

            const now = Date.now();
            const ref = convoRef(kind, id);

            try {
                const msgRef = ref.child('messages').push();
                await Promise.all([
                    msgRef.set({
                        senderId: currentUser.id,
                        senderName: currentUser.name,
                        text: text,
                        createdAt: now
                    }),
                    ref.child('meta').update({
                        lastMessage: text.length > 80 ? text.slice(0, 80) + '…' : text,
                        lastAt: now,
                        lastSenderId: currentUser.id
                    }),
                    ref.child('reads/' + currentUser.id).set(now)
                ]);

                // Direct chats need both participants registered (harmless on repeat)
                if (kind === 'dm') {
                    ref.child('meta/participants').update({
                        [currentUser.id]: true,
                        [activePartnerId]: true
                    });
                }
            } catch (error) {
                console.error('Send error:', error);
                input.value = text;
                autoResizeInput(input);
                alert('Message could not be sent. Check your connection and try again.');
            }
        }

        async function deleteMessage(messageId) {
            if (!activeConvo || !currentUser) return;
            try {
                await db.ref(`${convoPath(activeConvo.kind, activeConvo.id)}/messages/${messageId}`).remove();
            } catch (error) {
                console.error('Delete message error:', error);
            }
        }

        // Read receipt: remember how far this profile has read this conversation
        function markConversationRead() {
            if (!currentUser || !activeConvo) return;
            const kind = activeConvo.kind, id = activeConvo.id;
            if (!convoNode(kind, id)) return;
            const msgs = convoMessages(kind, id);
            const lastAt = msgs.length ? (msgs[msgs.length - 1].createdAt || 0) : 0;
            if (lastAt <= readTs(kind, id, currentUser.id)) return;
            db.ref(`${convoPath(kind, id)}/reads/${currentUser.id}`)
                .set(Math.max(Date.now(), lastAt))
                .catch(() => {});
        }

        // Backwards-compatible alias
        function markChatRead() { markConversationRead(); }

        /* ============================================================
           GROUPS — create, add members, photo, manage
           ============================================================ */
        let newGroupPhoto = null;
        let newGroupSelected = new Set();
        let groupInfoOpen = false;
        let editingGroupPhoto = null;
        let groupEditMode = false;

        /* ---------- image helper (keeps group photos small enough for Firebase) ---------- */
        function compressImage(file, maxSize, quality) {
            return new Promise((resolve, reject) => {
                if (!file || !String(file.type || '').startsWith('image/')) {
                    reject(new Error('Please choose an image file.'));
                    return;
                }
                const reader = new FileReader();
                reader.onerror = () => reject(new Error('That file could not be read.'));
                reader.onload = () => {
                    const img = new Image();
                    img.onerror = () => reject(new Error('That image could not be opened.'));
                    img.onload = () => {
                        try {
                            const scale = Math.min(1, maxSize / Math.max(img.width || 1, img.height || 1));
                            const w = Math.max(1, Math.round((img.width || maxSize) * scale));
                            const h = Math.max(1, Math.round((img.height || maxSize) * scale));
                            const canvas = document.createElement('canvas');
                            canvas.width = w;
                            canvas.height = h;
                            const ctx = canvas.getContext('2d');
                            ctx.drawImage(img, 0, 0, w, h);
                            resolve(canvas.toDataURL('image/jpeg', quality));
                        } catch (e) {
                            reject(new Error('That image could not be processed.'));
                        }
                    };
                    img.src = reader.result;
                };
                reader.readAsDataURL(file);
            });
        }

        function renderGroupPhotoPreview() {
            const picker = document.getElementById('group-photo-picker');
            if (!picker) return;
            if (newGroupPhoto) {
                picker.innerHTML = `
                    <img src="${newGroupPhoto}" alt="">
                    <button type="button" class="photo-remove" onclick="event.stopPropagation(); clearGroupPhoto()" aria-label="Remove photo">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                    </button>`;
                picker.style.borderStyle = 'solid';
            } else {
                picker.innerHTML = `
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    <span class="pick-label">Add photo</span>`;
                picker.style.borderStyle = 'dashed';
            }
        }

        function clearGroupPhoto() {
            newGroupPhoto = null;
            renderGroupPhotoPreview();
        }

        async function handleGroupPhotoSelect(event) {
            const file = event.target.files && event.target.files[0];
            if (!file) return;
            try {
                const data = await compressImage(file, 320, 0.82);
                newGroupPhoto = data;
                renderGroupPhotoPreview();
            } catch (error) {
                alert(error.message || 'That image could not be used.');
            } finally {
                event.target.value = '';
            }
        }

        function openCreateGroup() {
            if (!currentUser) return;
            hideNewChatSheet();
            newGroupPhoto = null;
            newGroupSelected = new Set();
            const nameInput = document.getElementById('group-name-input');
            if (nameInput) nameInput.value = '';
            renderGroupPhotoPreview();
            renderGroupMemberPicker();

            const modal = document.getElementById('create-group-modal');
            modal.classList.remove('opacity-0', 'pointer-events-none');
            modal.classList.add('opacity-100');
        }

        function closeCreateGroup() {
            const modal = document.getElementById('create-group-modal');
            if (!modal) return;
            modal.classList.add('opacity-0', 'pointer-events-none');
            modal.classList.remove('opacity-100');
        }

        function renderGroupMemberPicker() {
            const list = document.getElementById('group-member-picker');
            if (!list || !currentUser) return;

            const others = profiles.filter(p => p.id !== currentUser.id);

            let html = `
                <div class="member-row selected" style="cursor:default">
                    <div class="member-avatar ${currentUser.color}">${profileAvatarInner(currentUser)}</div>
                    <div class="flex-1 min-w-0">
                        <p class="member-name truncate">${escapeHtml(currentUser.name)} <span class="member-meta">(you)</span></p>
                        <p class="member-meta">Added automatically</p>
                    </div>
                    <div class="member-check">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                    </div>
                </div>`;

            if (others.length === 0) {
                html += `<div class="px-5 py-6 text-center"><p class="text-white/40 text-sm">No other profiles yet — create another profile first.</p></div>`;
            } else {
                html += others.map(p => {
                    const selected = newGroupSelected.has(p.id);
                    return `
                        <div class="member-row ${selected ? 'selected' : ''}" onclick="toggleGroupMember('${p.id}')">
                            <div class="member-avatar ${p.color}">${profileAvatarInner(p)}</div>
                            <div class="flex-1 min-w-0">
                                <p class="member-name truncate">${escapeHtml(p.name)}</p>
                                <p class="member-meta">${p.isKid ? 'Kids profile' : 'Profile'}</p>
                            </div>
                            <div class="member-check">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                            </div>
                        </div>`;
                }).join('');
            }

            list.innerHTML = html;
            updateCreateGroupButton();
        }

        function toggleGroupMember(profileId) {
            if (newGroupSelected.has(profileId)) newGroupSelected.delete(profileId);
            else newGroupSelected.add(profileId);
            renderGroupMemberPicker();
        }

        function updateCreateGroupButton() {
            const btn = document.getElementById('create-group-btn');
            if (!btn) return;
            const name = (document.getElementById('group-name-input')?.value || '').trim();
            btn.disabled = !(name.length > 0 && newGroupSelected.size > 0);
        }

        async function createGroup() {
            if (!currentUser) return;
            const name = (document.getElementById('group-name-input')?.value || '').trim();
            if (!name) { alert('Please give the group a name.'); return; }
            if (newGroupSelected.size === 0) { alert('Add at least one other profile to the group.'); return; }

            const btn = document.getElementById('create-group-btn');
            if (btn) btn.disabled = true;

            const members = {};
            members[currentUser.id] = true;
            newGroupSelected.forEach(id => { members[id] = true; });

            const groupRef = db.ref('groups').push();
            const now = Date.now();

            try {
                await groupRef.set({
                    id: groupRef.key,
                    name: name,
                    photo: newGroupPhoto || null,
                    createdBy: currentUser.id,
                    createdAt: now,
                    members: members,
                    meta: { lastMessage: '', lastAt: now, lastSenderId: '' },
                    reads: { [currentUser.id]: now }
                });

                closeCreateGroup();
                const newId = groupRef.key;
                // Give the listener a moment to deliver the new group, then open it
                setTimeout(() => openConversation('group', newId), 350);
            } catch (error) {
                console.error('Create group error:', error);
                alert('Could not create the group. Please try again.');
                if (btn) btn.disabled = false;
            }
        }

        /* ---------- Group info / management ---------- */
        function openGroupInfo() {
            if (!activeConvo || activeConvo.kind !== 'group') return;
            groupInfoOpen = true;
            groupEditMode = false;
            editingGroupPhoto = null;
            renderGroupInfo();
            const modal = document.getElementById('group-info-modal');
            modal.classList.remove('opacity-0', 'pointer-events-none');
            modal.classList.add('opacity-100');
        }

        function closeGroupInfo() {
            groupInfoOpen = false;
            groupEditMode = false;
            editingGroupPhoto = null;
            const modal = document.getElementById('group-info-modal');
            if (!modal) return;
            modal.classList.add('opacity-0', 'pointer-events-none');
            modal.classList.remove('opacity-100');
        }

        function renderGroupInfo() {
            if (!activeConvo || activeConvo.kind !== 'group' || !currentUser) return;
            const groupId = activeConvo.id;
            const g = getGroupById(groupId);
            const body = document.getElementById('group-info-body');
            if (!body) return;

            if (!g) {
                body.innerHTML = `<div class="px-5 py-10 text-center"><p class="text-white/50 text-sm">This group no longer exists.</p></div>`;
                return;
            }

            const isCreator = g.createdBy === currentUser.id;
            const memberIds = groupMemberIds(g);
            const nonMembers = profiles.filter(p => p.id !== currentUser.id && !g.members?.[p.id]);

            document.getElementById('group-info-sub').textContent =
                `${memberIds.length} member${memberIds.length === 1 ? '' : 's'} · created by ${(getProfileById(g.createdBy) || { name: 'Unknown' }).name}`;

            const avatarBlock = groupEditMode
                ? `<div class="flex flex-col items-center gap-2">
                       <div class="group-photo-picker" onclick="document.getElementById('group-photo-input-edit').click()" style="width:104px;height:104px;flex:0 0 104px">
                           ${editingGroupPhoto || g.photo
                               ? `<img src="${editingGroupPhoto || g.photo}" alt="">`
                               : `<div style="width:100%;height:100%">${groupAvatarInner(g)}</div>`}
                       </div>
                       <input type="file" id="group-photo-input-edit" accept="image/*" class="hidden" style="display:none" onchange="handleEditGroupPhoto(event)">
                       <span class="member-meta">Tap to change photo</span>
                   </div>`
                : `<div style="width:104px;height:104px;border-radius:999px;overflow:hidden;margin:0 auto">${groupAvatarInner(g)}</div>`;

            const nameBlock = groupEditMode
                ? `<input type="text" id="group-name-edit" class="group-input" maxlength="40" value="${escapeHtml(g.name || '')}" style="margin-top:12px">
                   <div class="flex gap-2 mt-2">
                       <button onclick="saveGroupEdits()" class="btn-primary" style="padding:10px">Save changes</button>
                       <button onclick="cancelGroupEdits()" class="btn-ghost" style="padding:10px;width:auto;padding-left:16px;padding-right:16px">Cancel</button>
                   </div>`
                : `<h3 class="text-white text-lg font-semibold text-center mt-3 flex items-center justify-center gap-2">
                       ${escapeHtml(g.name || 'Group')}
                       ${isCreator ? `<button onclick="startGroupEdits()" aria-label="Edit group" class="text-white/40 hover:text-white p-1">
                           <svg style="width:16px;height:16px" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                       </button>` : ''}
                   </h3>
                   <p class="text-white/40 text-xs text-center mt-1">${memberIds.length} member${memberIds.length === 1 ? '' : 's'}</p>`;

            const memberRows = memberIds.map(pid => {
                const p = getProfileById(pid);
                const name = p ? p.name : 'Deleted profile';
                const color = p ? p.color : 'bg-gray-600';
                const isMe = pid === currentUser.id;
                const canRemove = isCreator && !isMe;
                return `
                    <div class="member-row" style="cursor:default">
                        <div class="member-avatar ${color}">${profileAvatarInner(p)}</div>
                        <div class="flex-1 min-w-0">
                            <p class="member-name truncate">${escapeHtml(name)}${isMe ? ' <span class="member-meta">(you)</span>' : ''}</p>
                            <p class="member-meta">${pid === g.createdBy ? 'Group creator' : 'Member'}</p>
                        </div>
                        ${canRemove ? `<button onclick="removeGroupMember('${pid}')" title="Remove from group" aria-label="Remove from group"
                            class="p-2 rounded-lg text-white/35 hover:text-red-400 hover:bg-white/10">
                            <svg style="width:18px;height:18px" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                        </button>` : ''}
                    </div>`;
            }).join('');

            const addRows = nonMembers.length
                ? `<div class="info-section">
                       <div class="info-label">Add members</div>
                       ${nonMembers.map(p => `
                           <div class="member-row" onclick="addGroupMember('${p.id}')">
                               <div class="member-avatar ${p.color}">${profileAvatarInner(p)}</div>
                               <div class="flex-1 min-w-0">
                                   <p class="member-name truncate">${escapeHtml(p.name)}</p>
                                   <p class="member-meta">Tap to add</p>
                               </div>
                               <div class="member-check" style="border-color:rgba(99,102,241,0.7);background:rgba(99,102,241,0.25)">
                                   <svg style="display:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 4v16m8-8H4"/></svg>
                               </div>
                           </div>`).join('')}
                   </div>`
                : `<div class="info-section"><div class="info-label">Add members</div>
                       <p class="px-5 pb-2 text-white/35 text-xs">Every other profile is already in this group.</p>
                   </div>`;

            const dangerRows = `<div class="info-section px-5 pb-5" style="display:flex;flex-direction:column;gap:8px">
                    ${isCreator
                        ? `<button onclick="deleteGroup()" class="btn-danger">Delete group</button>
                           <p class="text-white/25 text-[11px] text-center">You are the creator — deleting removes it for everyone.</p>`
                        : `<button onclick="leaveGroup()" class="btn-danger">Leave group</button>`}
                </div>`;

            body.innerHTML = `
                <div class="px-5 pt-5 pb-3 text-center">
                    ${avatarBlock}
                    ${nameBlock}
                </div>
                <div class="info-section">
                    <div class="info-label">${memberIds.length} member${memberIds.length === 1 ? '' : 's'}</div>
                    ${memberRows}
                </div>
                ${addRows}
                ${dangerRows}
            `;
        }

        function startGroupEdits() {
            groupEditMode = true;
            editingGroupPhoto = null;
            renderGroupInfo();
        }

        function cancelGroupEdits() {
            groupEditMode = false;
            editingGroupPhoto = null;
            renderGroupInfo();
        }

        async function handleEditGroupPhoto(event) {
            const file = event.target.files && event.target.files[0];
            if (!file) return;
            try {
                editingGroupPhoto = await compressImage(file, 320, 0.82);
                renderGroupInfo();
            } catch (error) {
                alert(error.message || 'That image could not be used.');
            } finally {
                event.target.value = '';
            }
        }

        async function saveGroupEdits() {
            if (!activeConvo || activeConvo.kind !== 'group') return;
            const g = getGroupById(activeConvo.id);
            if (!g) return;
            const name = (document.getElementById('group-name-edit')?.value || '').trim();
            if (!name) { alert('The group needs a name.'); return; }

            const updates = { name };
            if (editingGroupPhoto) updates.photo = editingGroupPhoto;

            try {
                await db.ref(`groups/${activeConvo.id}`).update(updates);
                if (editingGroupPhoto) g.photo = editingGroupPhoto;
                g.name = name;
                groupEditMode = false;
                editingGroupPhoto = null;
                // Refresh the conversation header
                openConversation('group', activeConvo.id);
                renderGroupInfo();
            } catch (error) {
                console.error('Save group error:', error);
                alert('Could not save the changes. Please try again.');
            }
        }

        async function addGroupMember(profileId) {
            if (!activeConvo || activeConvo.kind !== 'group') return;
            try {
                await db.ref(`groups/${activeConvo.id}/members/${profileId}`).set(true);
                renderGroupInfo();
            } catch (error) {
                console.error('Add member error:', error);
                alert('Could not add that profile.');
            }
        }

        async function removeGroupMember(profileId) {
            if (!activeConvo || activeConvo.kind !== 'group' || !currentUser) return;
            const g = getGroupById(activeConvo.id);
            if (!g || g.createdBy !== currentUser.id) return;
            const p = getProfileById(profileId);
            if (!confirm(`Remove ${p ? p.name : 'this profile'} from the group?`)) return;
            try {
                await db.ref(`groups/${activeConvo.id}/members/${profileId}`).remove();
                renderGroupInfo();
            } catch (error) {
                console.error('Remove member error:', error);
            }
        }

        async function leaveGroup() {
            if (!activeConvo || activeConvo.kind !== 'group' || !currentUser) return;
            const g = getGroupById(activeConvo.id);
            if (!g) return;
            if (g.createdBy === currentUser.id) {
                alert('You created this group, so you can’t leave it. Delete the group instead.');
                return;
            }
            if (!confirm('Leave this group? You will stop receiving its messages.')) return;
            const groupId = activeConvo.id;
            try {
                await db.ref(`groups/${groupId}/members/${currentUser.id}`).remove();
                closeGroupInfo();
                backToChatList();
            } catch (error) {
                console.error('Leave group error:', error);
                alert('Could not leave the group.');
            }
        }

        async function deleteGroup() {
            if (!activeConvo || activeConvo.kind !== 'group' || !currentUser) return;
            const g = getGroupById(activeConvo.id);
            if (!g || g.createdBy !== currentUser.id) return;
            if (!confirm(`Delete “${g.name || 'this group'}” for everyone? This cannot be undone.`)) return;
            const groupId = activeConvo.id;
            try {
                await db.ref(`groups/${groupId}`).remove();
                closeGroupInfo();
                backToChatList();
            } catch (error) {
                console.error('Delete group error:', error);
                alert('Could not delete the group.');
            }
        }

        /* ============================================================
           VOICE CALLS (WebRTC) — signaling over Firebase Realtime DB
           call node: calls/<id> { callerId, calleeId, status, offer,
                      answer, callerCandidates, calleeCandidates, ... }
           ============================================================ */
        const RTC_CONFIG = {
            iceServers: [
                { urls: 'stun:stun.l.google.com:19302' },
                { urls: 'stun:stun1.l.google.com:19302' }
            ]
        };

        let callsRef = null;
        let activeCall = null;
        let callCandidatesBuffer = [];
        let callRingTimeout = null;
        let callDurationTimer = null;
        let callConnectedAt = 0;
        let ringtoneTimer = null;

        function rtcAvailable() {
            return !!(navigator.mediaDevices && navigator.mediaDevices.getUserMedia &&
                (window.RTCPeerConnection || window.webkitRTCPeerConnection));
        }

        function startCallListener() {
            if (!currentUser || callsRef) return;
            callsRef = db.ref('calls');
            callsRef.on('child_added', snap => handleCallSignal(snap.key, snap.val()));
            callsRef.on('child_changed', snap => handleCallSignal(snap.key, snap.val()));
            callsRef.on('child_removed', snap => {
                if (activeCall && activeCall.callId === snap.key) endActiveCall(false);
            });
        }

        function stopCallListener() {
            if (callsRef) { callsRef.off(); callsRef = null; }
            endActiveCall(true);
        }

        function handleCallSignal(callId, call) {
            if (!call || !currentUser) return;
            const iAmCaller = call.callerId === currentUser.id;
            const iAmCallee = call.calleeId === currentUser.id;
            if (!iAmCaller && !iAmCallee) return;

            // Incoming ringing call we haven't picked up yet
            if (iAmCallee && (!activeCall || activeCall.callId !== callId)) {
                if (call.status === 'ringing') presentIncomingCall(callId, call);
                return;
            }
            // A different outgoing call that isn't ours
            if (iAmCaller && (!activeCall || activeCall.callId !== callId)) return;

            const c = activeCall;
            if (call.status === 'ended' || call.status === 'declined' || call.status === 'busy') {
                if (!c.endedHandled) { c.endedHandled = true; endActiveCall(false); }
                return;
            }

            if (iAmCaller) {
                if (call.status === 'accepted' && !c.acceptedSeen) {
                    c.acceptedSeen = true;
                    updateCallStatusText('Connecting…');
                }
                if (call.answer && c.pc && !c.remoteSet) {
                    c.pc.setRemoteDescription(call.answer).then(() => {
                        c.remoteSet = true;
                        flushCandidates();
                    }).catch(e => console.warn('apply answer failed', e));
                }
                addCandidatesFrom(call.calleeCandidates, c);
            } else {
                addCandidatesFrom(call.callerCandidates, c);
            }
        }

        function addCandidatesFrom(obj, c) {
            if (!obj) return;
            Object.keys(obj).forEach(key => {
                if (c.addedCandidateKeys.has(key)) return;
                c.addedCandidateKeys.add(key);
                const cand = obj[key];
                if (!cand) return;
                if (c.pc && c.remoteSet) {
                    c.pc.addIceCandidate(cand).catch(() => {});
                } else {
                    callCandidatesBuffer.push(cand);
                }
            });
        }

        function flushCandidates() {
            if (!activeCall || !activeCall.pc) return;
            const c = activeCall;
            while (callCandidatesBuffer.length) {
                const cand = callCandidatesBuffer.shift();
                c.pc.addIceCandidate(cand).catch(() => {});
            }
        }

        function newPeerConnection() {
            const PC = window.RTCPeerConnection || window.webkitRTCPeerConnection;
            const pc = new PC(RTC_CONFIG);
            pc.onicecandidate = e => {
                if (!e.candidate || !activeCall) return;
                const path = activeCall.isCaller
                    ? `calls/${activeCall.callId}/callerCandidates`
                    : `calls/${activeCall.callId}/calleeCandidates`;
                db.ref(path).push(e.candidate.toJSON ? e.candidate.toJSON() : e.candidate);
            };
            pc.ontrack = e => {
                if (!activeCall) return;
                activeCall.remoteStream = (e.streams && e.streams[0]) ? e.streams[0] : activeCall.remoteStream;
                attachRemoteMedia();
            };
            pc.onconnectionstatechange = () => {
                if (!activeCall) return;
                if (pc.connectionState === 'connected') {
                    stopRingtone();
                    if (!callDurationTimer) startCallTimer();
                    updateCallSub('Connected');
                } else if (pc.connectionState === 'failed') {
                    endActiveCall(true);
                }
            };
            return pc;
        }

        function attachRemoteMedia() {
            if (!activeCall || !activeCall.remoteStream) return;
            if (activeCall.isVideo) {
                const v = document.getElementById('call-remote-video');
                if (v) { v.srcObject = activeCall.remoteStream; v.play().catch(() => {}); }
            } else {
                const a = document.getElementById('call-audio');
                if (a) { a.srcObject = activeCall.remoteStream; a.play().catch(() => {}); }
            }
        }

        function attachLocalPreview() {
            const v = document.getElementById('call-local-video');
            if (!v || !activeCall || !activeCall.localStream) return;
            v.srcObject = activeCall.localStream;
            v.classList.add('is-live');
            v.play().catch(() => {});
        }

        /* ---------- outgoing ---------- */
        async function startCallWithProfile(partnerId, video) {
            if (!currentUser || activeCall) return;
            const isVideo = !!video;
            if (!rtcAvailable()) { alert('Calls are not supported in this browser.'); return; }
            const partner = getProfileById(partnerId);
            if (!partner) { alert('That profile no longer exists.'); return; }

            hideNewChatSheet();

            let stream;
            try {
                stream = await navigator.mediaDevices.getUserMedia({
                    audio: true,
                    video: isVideo ? { facingMode: 'user', width: { ideal: 1280 }, height: { ideal: 720 } } : false
                });
            } catch (e) {
                alert((isVideo ? 'Camera' : 'Microphone') + ' access was denied or unavailable.');
                return;
            }

            const callId = db.ref('calls').push().key;
            const now = Date.now();
            activeCall = {
                callId, peerId: partnerId, peerName: partner.name, isVideo,
                isCaller: true, ringing: false, answered: false, muted: false, camOff: false,
                pc: null, localStream: stream, remoteStream: null, remoteSet: false,
                addedCandidateKeys: new Set(), endedHandled: false, acceptedSeen: false
            };
            callCandidatesBuffer = [];

            await db.ref(`calls/${callId}`).set({
                callerId: currentUser.id,
                callerName: currentUser.name,
                calleeId: partnerId,
                calleeName: partner.name,
                video: isVideo,
                status: 'ringing',
                createdAt: now
            });

            showCallOverlay();
            setCallIdentity(partner);
            attachLocalPreview();
            updateCallStatusText('Calling…');
            updateCallSub(isVideo ? 'Video call' : 'Ringing');
            renderCallControls('active');

            try {
                const pc = newPeerConnection();
                activeCall.pc = pc;
                stream.getTracks().forEach(t => pc.addTrack(t, stream));
                const offer = await pc.createOffer();
                await pc.setLocalDescription(offer);
                await db.ref(`calls/${callId}/offer`).set({ type: offer.type, sdp: offer.sdp });
            } catch (e) {
                console.error('Start call error:', e);
                endActiveCall(true);
                return;
            }

            callRingTimeout = setTimeout(() => {
                if (activeCall && activeCall.isCaller && !activeCall.answered) endActiveCall(true);
            }, 45000);
        }

        function startCallFromHeader(video) {
            if (!activeConvo || activeConvo.kind !== 'dm') return;
            startCallWithProfile(activePartnerId, !!video);
        }

        function startCallFromSheet(partnerId, video) {
            hideNewChatSheet();
            startCallWithProfile(partnerId, !!video);
        }

        /* ---------- incoming ---------- */
        function presentIncomingCall(callId, call) {
            if (activeCall) {
                if (activeCall.callId !== callId) {
                    db.ref(`calls/${callId}/status`).set('busy').catch(() => {});
                }
                return;
            }
            if ((Date.now() - (call.createdAt || 0)) > 60000) return;

            activeCall = {
                callId, peerId: call.callerId, peerName: call.callerName || 'Unknown',
                isVideo: !!call.video,
                isCaller: false, ringing: true, answered: false, muted: false, camOff: false,
                pc: null, localStream: null, remoteStream: null, remoteSet: false,
                addedCandidateKeys: new Set(), endedHandled: false
            };
            callCandidatesBuffer = [];

            showCallOverlay();
            setCallIdentity(getProfileById(call.callerId) || { name: call.callerName || 'Unknown', color: 'bg-blue-600' });
            updateCallStatusText(call.video ? 'Incoming video call' : 'Incoming call');
            updateCallSub('is calling…');
            renderCallControls('incoming');
            startRingtone();

            callRingTimeout = setTimeout(() => {
                if (activeCall && activeCall.callId === callId && activeCall.ringing) endActiveCall(true);
            }, 60000);
        }

        async function acceptIncomingCall() {
            if (!activeCall || activeCall.isCaller) return;
            const callId = activeCall.callId;

            let call;
            try {
                const snap = await db.ref(`calls/${callId}`).once('value');
                call = snap.val();
            } catch (e) {
                endActiveCall(true);
                return;
            }
            if (!call || !call.offer) { endActiveCall(true); return; }

            const isVideo = !!call.video;
            activeCall.isVideo = isVideo;

            let stream;
            try {
                stream = await navigator.mediaDevices.getUserMedia({
                    audio: true,
                    video: isVideo ? { facingMode: 'user', width: { ideal: 1280 }, height: { ideal: 720 } } : false
                });
            } catch (e) {
                db.ref(`calls/${callId}/status`).set('declined').catch(() => {});
                endActiveCall(true);
                alert((isVideo ? 'Camera' : 'Microphone') + ' access was denied or unavailable.');
                return;
            }
            activeCall.localStream = stream;
            activeCall.ringing = false;
            const callOverlay = document.getElementById('call-overlay');
            if (callOverlay) callOverlay.classList.toggle('video-mode', isVideo);
            attachLocalPreview();

            try {
                const pc = newPeerConnection();
                activeCall.pc = pc;
                stream.getTracks().forEach(t => pc.addTrack(t, stream));
                await pc.setRemoteDescription(call.offer);
                activeCall.remoteSet = true;
                addCandidatesFrom(call.callerCandidates, activeCall);
                const answer = await pc.createAnswer();
                await pc.setLocalDescription(answer);
                await db.ref(`calls/${callId}/answer`).set({ type: answer.type, sdp: answer.sdp });
                await db.ref(`calls/${callId}/status`).set('accepted');
                flushCandidates();
            } catch (e) {
                console.error('Accept call error:', e);
                endActiveCall(true);
                return;
            }

            stopRingtone();
            updateCallStatusText('Connecting…');
            updateCallSub('Connected');
            renderCallControls('active');
        }

        async function declineIncomingCall() {
            if (!activeCall) return;
            const callId = activeCall.callId;
            try { await db.ref(`calls/${callId}/status`).set('declined'); } catch (e) {}
            endActiveCall(true);
        }

        function toggleCallMute() {
            if (!activeCall || !activeCall.localStream) return;
            activeCall.muted = !activeCall.muted;
            activeCall.localStream.getAudioTracks().forEach(t => { t.enabled = !activeCall.muted; });
            renderCallControls(activeCall.ringing ? 'incoming' : 'active');
        }

        /* ---------- teardown ---------- */
        function endActiveCall(local) {
            clearTimeout(callRingTimeout);
            callRingTimeout = null;

            const call = activeCall;
            hideCallUI();
            if (!call) { activeCall = null; callCandidatesBuffer = []; return; }

            if (local && call.callId) {
                db.ref(`calls/${call.callId}/status`).set('ended').catch(() => {});
                setTimeout(() => { db.ref(`calls/${call.callId}`).remove().catch(() => {}); }, 1500);
            }

            try {
                if (call.localStream) call.localStream.getTracks().forEach(t => t.stop());
                if (call.pc) {
                    call.pc.onconnectionstatechange = null;
                    call.pc.onicecandidate = null;
                    call.pc.ontrack = null;
                    call.pc.close();
                }
            } catch (e) {}

            activeCall = null;
            callCandidatesBuffer = [];
        }

        /* ---------- call UI ---------- */
        function showCallOverlay() {
            const overlay = document.getElementById('call-overlay');
            if (!overlay) return;
            const rv = document.getElementById('call-remote-video');
            const lv = document.getElementById('call-local-video');
            if (rv) rv.srcObject = null;
            if (lv) { lv.srcObject = null; lv.classList.remove('is-live'); }
            overlay.classList.toggle('video-mode', !!(activeCall && activeCall.isVideo));
            overlay.classList.remove('opacity-0', 'pointer-events-none');
            overlay.classList.add('opacity-100');
            document.body.classList.add('app-no-scroll');
            document.addEventListener('keydown', onCallKeydown);
        }

        function hideCallUI() {
            const overlay = document.getElementById('call-overlay');
            if (overlay) {
                overlay.classList.add('opacity-0', 'pointer-events-none');
                overlay.classList.remove('opacity-100', 'video-mode');
            }
            document.body.classList.remove('app-no-scroll');
            document.removeEventListener('keydown', onCallKeydown);
            stopRingtone();
            clearInterval(callDurationTimer);
            callDurationTimer = null;
            callConnectedAt = 0;
            const rv = document.getElementById('call-remote-video');
            const lv = document.getElementById('call-local-video');
            if (rv) rv.srcObject = null;
            if (lv) { lv.srcObject = null; lv.classList.remove('is-live'); }
            const audio = document.getElementById('call-audio');
            if (audio) audio.srcObject = null;
        }

        function onCallKeydown(e) {
            if (e.key === 'Escape' && activeCall) { e.preventDefault(); endActiveCall(true); }
        }

        function setCallIdentity(profile) {
            const nameEl = document.getElementById('call-name');
            const avatarEl = document.getElementById('call-avatar');
            const wrap = document.getElementById('call-avatar-wrap');
            if (nameEl) nameEl.textContent = profile ? profile.name : 'Unknown';
            if (avatarEl) {
                avatarEl.className = `w-full h-full rounded-full overflow-hidden ${profile && profile.color ? profile.color : 'bg-blue-600'}`;
                avatarEl.innerHTML = profile ? profileAvatarInner(profile) : '';
            }
            if (wrap) wrap.classList.toggle('call-ringing', !!(activeCall && activeCall.isCaller === false));
        }

        function updateCallStatusText(text) {
            const el = document.getElementById('call-status');
            if (el) el.textContent = text;
        }

        function updateCallSub(text) {
            const el = document.getElementById('call-sub');
            if (el) el.textContent = text;
        }

        function startCallTimer() {
            callConnectedAt = Date.now();
            clearInterval(callDurationTimer);
            const tick = () => {
                const s = Math.floor((Date.now() - callConnectedAt) / 1000);
                const mm = String(Math.floor(s / 60)).padStart(2, '0');
                const ss = String(s % 60).padStart(2, '0');
                updateCallStatusText(`${mm}:${ss}`);
            };
            tick();
            callDurationTimer = setInterval(tick, 1000);
        }

        function renderCallControls(state) {
            const el = document.getElementById('call-controls');
            if (!el) return;
            const phoneIcon = `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 004.11 2h3a2 2 0 012 1.72c.13.96.36 1.9.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0122 16.92z"/></svg>`;
            const hangupIcon = `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.68 13.31a16 16 0 003.41 2.6l1.27-1.27a2 2 0 012.11-.45c.4.14.79.25 1.18.34a2 2 0 011.5 1.94V19a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.42 19.42 0 01-3.33-2.67m-2.67-3.34a19.79 19.79 0 01-3.07-8.63A2 2 0 014.11 2h2.93a2 2 0 011.94 1.5c.09.44.19.87.34 1.18a2 2 0 01-.45 2.11L7.61 8.06M23 1L1 23"/></svg>`;
            if (state === 'incoming') {
                el.innerHTML = `
                    <div class="flex flex-col items-center gap-2">
                        <button onclick="declineIncomingCall()" class="call-round" style="background:#ef4444" aria-label="Decline">${hangupIcon}</button>
                        <span class="text-white/50 text-xs">Decline</span>
                    </div>
                    <div class="flex flex-col items-center gap-2">
                        <button onclick="acceptIncomingCall()" class="call-round" style="background:#22c55e" aria-label="Accept">${phoneIcon}</button>
                        <span class="text-white/50 text-xs">Accept</span>
                    </div>`;
            } else {
                const muted = activeCall && activeCall.muted;
                const camOff = activeCall && activeCall.camOff;
                const isVideo = activeCall && activeCall.isVideo;
