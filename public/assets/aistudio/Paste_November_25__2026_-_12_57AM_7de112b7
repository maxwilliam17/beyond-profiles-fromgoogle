        function buildPinKeypad() {
            const pad = document.getElementById('pin-keypad');
            if (!pad) return;
            let html = '';
            for (let d = 1; d <= 9; d++) {
                html += `<button type="button" data-pin="${d}" class="pin-key h-16 rounded-2xl text-white text-2xl font-medium">${d}</button>`;
            }
            html += `<div></div>`;
            html += `<button type="button" data-pin="0" class="pin-key h-16 rounded-2xl text-white text-2xl font-medium">0</button>`;
            html += `<button type="button" data-pin="del" aria-label="Delete" class="pin-key h-16 rounded-2xl flex items-center justify-center text-white/70">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2M3 12l6-6h10a2 2 0 012 2v8a2 2 0 01-2 2H9l-6-6z"/>
