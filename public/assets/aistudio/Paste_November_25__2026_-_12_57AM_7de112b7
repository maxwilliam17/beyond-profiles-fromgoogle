        /* ---------- ringtone ---------- */
        function startRingtone() {
            stopRingtone();
            try {
                const Ctx = window.AudioContext || window.webkitAudioContext;
                if (!Ctx) return;
                if (!notifAudioCtx) notifAudioCtx = new Ctx();
                const ctx = notifAudioCtx;
                if (ctx.state === 'suspended') ctx.resume().catch(() => {});
                const beep = () => {
                    try {
                        const now = ctx.currentTime;
                        const osc = ctx.createOscillator();
                        const gain = ctx.createGain();
                        osc.type = 'sine';
                        osc.frequency.setValueAtTime(440, now);
                        osc.frequency.setValueAtTime(480, now + 0.35);
                        gain.gain.setValueAtTime(0.0001, now);
                        gain.gain.linearRampToValueAtTime(0.14, now + 0.05);
                        gain.gain.setValueAtTime(0.14, now + 0.65);
                        gain.gain.linearRampToValueAtTime(0.0001, now + 0.8);
                        osc.connect(gain).connect(ctx.destination);
                        osc.start(now);
                        osc.stop(now + 0.85);
                    } catch (e) {}
                };
                beep();
                ringtoneTimer = setInterval(beep, 2000);
            } catch (e) {}
        }

