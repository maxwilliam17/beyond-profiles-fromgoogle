        /* ============================================================
           PROFILE PIN LOCK
           ============================================================ */
        const PIN_LENGTH = 4;
        const PIN_MAX_ATTEMPTS = 5;
        const PIN_LOCK_SECONDS = 30;
        const PIN_PEPPER = 'beyond-profiles-v1';

        let pinScreenOpen = false;
        let pinLockTimer = null;
        let pinState = {
            profile: null,
