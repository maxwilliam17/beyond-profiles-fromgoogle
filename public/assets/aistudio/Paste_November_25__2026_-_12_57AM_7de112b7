        async function handleEditProfilePhoto(event) {
            const file = event.target.files && event.target.files[0];
            if (!file) return;
            try {
                editingProfilePhoto = await compressImage(file, 400, 0.82);
                editingProfilePhotoChanged = true;
                editingProfilePhotoCleared = false;
                document.getElementById('edit-avatar-img').src = editingProfilePhoto;
                setEditPhotoReset(true);
            } catch (error) {
                alert(error.message || 'That image could not be used.');
            } finally {
                event.target.value = '';
            }
        }

        function resetEditProfilePhoto() {
            const profile = profiles.find(p => p.id === currentEditId);
            editingProfilePhoto = null;
            editingProfilePhotoChanged = true;
            editingProfilePhotoCleared = true;
            document.getElementById('edit-avatar-img').src = defaultAvatarUrl(profile ? profile.name : 'User');
            setEditPhotoReset(false);
        }

        function showAddProfile() {
            selectedAddColor = 'bg-blue-500';
            newProfilePhoto = null;
            setAddPhotoButton(false);
            document.getElementById('new-profile-name').value = '';
            document.getElementById('kids-profile').checked = false;
            updateAddColorPicker();
            updateAddAvatarPreview();
            
            const modal = document.getElementById('add-modal-profile');
            modal.classList.remove('opacity-0', 'pointer-events-none');
            modal.classList.add('opacity-100');
        }

        function hideAddProfile() {
            const modal = document.getElementById('add-modal-profile');
            modal.classList.add('opacity-0', 'pointer-events-none');
            modal.classList.remove('opacity-100');
        }

        function selectAddColor(colorClass, colorName) {
            selectedAddColor = colorClass;
            updateAddColorPicker();
            updateAddAvatarPreview();
        }

        function updateAddColorPicker() {
            document.querySelectorAll('#add-color-picker .color-option').forEach(btn => {
                btn.classList.remove('ring-2', 'ring-white', 'ring-offset-2', 'ring-offset-[#141414]');
            });
            const activeBtn = document.querySelector(`#add-color-picker .${selectedAddColor.replace('-', '\\-')}`);
            if (activeBtn) {
                activeBtn.classList.add('ring-2', 'ring-white', 'ring-offset-2', 'ring-offset-[#141414]');
            }
        }

        function updateAddAvatarPreview() {
            const preview = document.getElementById('add-avatar-preview');
            const name = document.getElementById('new-profile-name').value || 'NewUser';
            preview.className = `avatar-editor w-24 h-24 md:w-36 md:h-36 rounded-md ${selectedAddColor} overflow-hidden flex-shrink-0`;
            document.getElementById('add-avatar-img').src = newProfilePhoto || defaultAvatarUrl(name);
        }

        document.getElementById('new-profile-name')?.addEventListener('input', updateAddAvatarPreview);

        function addNewProfile() {
            const name = document.getElementById('new-profile-name').value.trim() || 'New User';
            const isKid = document.getElementById('kids-profile').checked;
            const pin = document.getElementById('new-profile-pin').value.trim();
            const pinConfirm = document.getElementById('new-profile-pin-confirm').value.trim();

            if (profiles.length >= 5) {
                alert('Maximum 5 profiles allowed');
                return;
            }

            if (!isPinValid(pin)) {
                alert('Please choose a 4-digit PIN for this profile.');
                document.getElementById('new-profile-pin').focus();
                return;
            }

            if (pin !== pinConfirm) {
                alert('The two PINs do not match. Please try again.');
                document.getElementById('new-profile-pin-confirm').value = '';
                document.getElementById('new-profile-pin-confirm').focus();
                return;
            }

            const newProfileRef = profilesRef.push();
            const salt = makeSalt();

            const newProfile = {
                id: newProfileRef.key,
                name: name,
                color: selectedAddColor,
                isKid: isKid,
                photo: newProfilePhoto || null,
                pinHash: hashPin(pin, salt),
                pinSalt: salt,
                pinLength: PIN_LENGTH,
                createdAt: Date.now()
            };

            newProfileRef.set(newProfile);
            hideAddProfile();
        }

        function showEditProfile(profile) {
            currentEditId = profile.id;
            selectedEditColor = profile.color;
            
            document.getElementById('edit-profile-name').value = profile.name;
            document.getElementById('edit-kids-profile').checked = profile.isKid;
            document.getElementById('edit-profile-pin').value = '';
            document.getElementById('edit-profile-pin-confirm').value = '';
            editingProfilePhoto = null;
            editingProfilePhotoChanged = false;
            editingProfilePhotoCleared = false;
            setEditPhotoReset(!!profile.photo);
            
            updateEditColorPicker();
            updateEditAvatarPreview(profile.name);
            
            const modal = document.getElementById('edit-modal');
            modal.classList.remove('opacity-0', 'pointer-events-none');
            modal.classList.add('opacity-100');
        }

        function hideEditProfile() {
            const modal = document.getElementById('edit-modal');
            modal.classList.add('opacity-0', 'pointer-events-none');
            modal.classList.remove('opacity-100');
            currentEditId = null;
        }

        function selectEditColor(colorClass, colorName) {
            selectedEditColor = colorClass;
            updateEditColorPicker();
            const name = document.getElementById('edit-profile-name').value || 'User';
            updateEditAvatarPreview(name);
        }

        function updateEditColorPicker() {
            document.querySelectorAll('#edit-color-picker .color-option').forEach(btn => {
                btn.classList.remove('ring-2', 'ring-white', 'ring-offset-2', 'ring-offset-[#141414]');
                if (btn.dataset.color === selectedEditColor) {
                    btn.classList.add('ring-2', 'ring-white', 'ring-offset-2', 'ring-offset-[#141414]');
                }
            });
        }

        function updateEditAvatarPreview(name) {
            const preview = document.getElementById('edit-avatar-preview');
            preview.className = `avatar-editor w-24 h-24 md:w-36 md:h-36 rounded-md ${selectedEditColor} overflow-hidden flex-shrink-0 relative`;
            // While editing, show the pending photo (or the stored one), else the generated avatar
            const current = profiles.find(p => p.id === currentEditId);
            const stored = (!editingProfilePhotoChanged && current && current.photo) ? current.photo : null;
            document.getElementById('edit-avatar-img').src = editingProfilePhoto || stored || defaultAvatarUrl(name);
        }

        document.getElementById('edit-profile-name')?.addEventListener('input', (e) => {
            updateEditAvatarPreview(e.target.value || 'User');
        });

        function saveEditProfile() {
            if (!currentEditId) return;

            const newPin = document.getElementById('edit-profile-pin').value.trim();
            const newPinConfirm = document.getElementById('edit-profile-pin-confirm').value.trim();
            const existing = profiles.find(p => p.id === currentEditId) || {};

            // Changed PIN must be valid and confirmed; blank keeps the current one
            if (newPin || newPinConfirm) {
                if (!isPinValid(newPin)) {
                    alert('The new PIN must be exactly 4 digits.');
                    document.getElementById('edit-profile-pin').focus();
                    return;
                }
                if (newPin !== newPinConfirm) {
                    alert('The two PINs do not match. Please try again.');
                    document.getElementById('edit-profile-pin-confirm').value = '';
                    document.getElementById('edit-profile-pin-confirm').focus();
                    return;
                }
            }

            // update() (not set()) so fields like pinHash/pinSalt/createdAt survive
            const updates = {
                id: currentEditId,
                name: document.getElementById('edit-profile-name').value.trim() || 'User',
                color: selectedEditColor,
                isKid: document.getElementById('edit-kids-profile').checked
            };

            if (newPin) {
                const salt = makeSalt();
                updates.pinHash = hashPin(newPin, salt);
                updates.pinSalt = salt;
                updates.pinLength = PIN_LENGTH;
            }

            // Profile picture: only touch it when the user actually changed it
            if (editingProfilePhotoChanged) {
                updates.photo = editingProfilePhotoCleared ? null : editingProfilePhoto;
            }

            profilesRef.child(currentEditId).update(updates).catch(error => {
                console.error('Profile save error:', error);
                alert('Could not save the profile. Please try again.');
            });

            // Reflect changes locally right away
            const idx = profiles.findIndex(p => p.id === currentEditId);
            if (idx > -1) profiles[idx] = { ...profiles[idx], ...updates };

            hideEditProfile();
        }

        function confirmDeleteProfile() {
            const profile = profiles.find(p => p.id === currentEditId);
            if (profile) {
                document.getElementById('delete-profile-name').textContent = 
                    `Are you sure you want to delete the profile "${profile.name}"? This action cannot be undone.`;
            }
            
            const modal = document.getElementById('delete-modal');
            modal.classList.remove('opacity-0', 'pointer-events-none');
            modal.classList.add('opacity-100');
        }

        function hideDeleteModal() {
            const modal = document.getElementById('delete-modal');
            modal.classList.add('opacity-0', 'pointer-events-none');
            modal.classList.remove('opacity-100');
        }

        function deleteProfile() {
            if (!currentEditId) return;
            
            // Delete user data as well
            db.ref(`userData/${currentEditId}`).remove();
            
            profilesRef.child(currentEditId).remove();
            hideDeleteModal();
            hideEditProfile();
        }

        // Initialize event listeners
        setTimeout(() => {
            document.getElementById('new-profile-name')?.addEventListener('input', updateAddAvatarPreview);
            document.getElementById('edit-profile-name')?.addEventListener('input', (e) => {
                updateEditAvatarPreview(e.target.value || 'User');
            });
        }, 100);
    </script>
