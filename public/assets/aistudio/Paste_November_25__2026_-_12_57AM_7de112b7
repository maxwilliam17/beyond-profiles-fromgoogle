        function closePinScreen() {
            pinScreenOpen = false;
            clearInterval(pinLockTimer);
            pinLockTimer = null;
            document.removeEventListener('keydown', handlePinKeydown);

            const modal = document.getElementById('pin-modal');
            modal.classList.add('opacity-0', 'pointer-events-none');
