                <button onclick="deleteProfile()" class="bg-red-600 text-white font-medium px-8 py-2 text-lg hover:bg-red-700 transition-colors">DELETE</button>
                <button onclick="hideDeleteModal()" class="border border-gray-500 text-gray-400 px-8 py-2 text-lg hover:border-white hover:text-white transition-colors">CANCEL</button>
            </div>
        </div>
    </div>

    <script>
        // 🔥 Firebase Init
        const firebaseConfig = {
            apiKey: "AIzaSyD36k8EH1Xjr_eGQAS7qHZmDESfBDCN6rw",
            authDomain: "beyondprofiles-5b71a.firebaseapp.com",
            databaseURL: "https://beyondprofiles-5b71a-default-rtdb.firebaseio.com",
            projectId: "beyondprofiles-5b71a",
            storageBucket: "beyondprofiles-5b71a.firebasestorage.app",
            messagingSenderId: "894821956984",
            appId: "1:894821956984:web:c71ef1b440146a9dd2dc8d"
        };

        firebase.initializeApp(firebaseConfig);
        const db = firebase.database();
        const profilesRef = db.ref("profiles");

        // Profile data
        let profiles = [];
        let currentUser = null;
        let isManageMode = false;
        let currentEditId = null;
        let selectedAddColor = 'bg-blue-500';
        let selectedEditColor = 'bg-blue-500';

        // Dashboard data
        let currentSection = null;
        let userData = { files: [], photos: [], videos: [], notes: [] };
        let selectedFile = null;
        let selectedNoteColor = '#fbbf24';
        let deleteItemId = null;
        let deleteItemType = null;

        /* ============================================================
           MESSENGER STATE
           ============================================================ */
        let chatsData = {};              // chatId     -> { meta, messages, reads }   (direct chats)
        let groupsData = {};             // groupId    -> { name, photo, members, ... } (group chats)
        let chatsRef = null;             // firebase ref for the chats root
        let groupsRef = null;            // firebase ref for the groups root
        let activeConvo = null;          // { kind: 'dm' | 'group', id }
        let activeChatId = null;         // direct chat id (kept for compatibility)
        let activePartnerId = null;      // the other profile's id in a direct chat
        let messengerOpen = false;       // is the messenger panel visible
        let stickToBottom = true;        // auto-scroll flag

        /* ---------- Profile pictures ---------- */
        // A profile's uploaded photo wins; otherwise fall back to the generated avatar
        function defaultAvatarUrl(name) {
            return `https://api.dicebear.com/7.x/avataaars/svg?seed=${encodeURIComponent(name || 'NewUser')}&backgroundColor=transparent`;
        }

        function avatarSrcFor(profile) {
            if (profile && profile.photo) return profile.photo;
            return defaultAvatarUrl(profile ? profile.name : 'NewUser');
        }

        // Load profiles from Firebase
        function loadProfilesFromFirebase() {
            profilesRef.on("value", snapshot => {
                const data = snapshot.val();
                profiles = data ? Object.values(data) : [];
                renderProfiles();
                refreshAvatarCaches();
                if (messengerOpen) {
                    renderChatList();
                    updateUnreadBadges();
                    if (activeConvo) {
                        refreshConversationHeader();
                        renderMessages();
                    }
                }
            });
        }

        // Initialize
        document.addEventListener('DOMContentLoaded', () => {
            loadProfilesFromFirebase();
            setupDragAndDrop();
            buildEmojiPicker();
            buildPinKeypad();
            attachPinInputFilters();
            installViewportTracking();

            // Notifications + PWA
            readPendingOpenFromUrl();
            registerServiceWorker();
            // Browsers only allow audio after a gesture — arm it on the first tap anywhere
            const armAudio = () => { unlockNotificationAudio(); document.removeEventListener('pointerdown', armAudio); };
            document.addEventListener('pointerdown', armAudio, { once: true });

            // Keep the tab title in sync with the current profile
            updateUnreadBadges();

            if (navigator.serviceWorker) {
                navigator.serviceWorker.addEventListener('message', event => {
                    const data = event.data || {};
                    if (data.type === 'open-conversation' && data.target) {
                        const [kind, id] = String(data.target).split(':');
                        pendingOpenTarget = { kind, id };
                        tryOpenPendingTarget();
                    }
                });
            }
        });

        // Keep the dashboard, messenger header and open conversation avatars in sync
        function refreshAvatarCaches() {
            if (!currentUser) return;
            const fresh = profiles.find(p => p.id === currentUser.id);
            if (fresh) currentUser = Object.assign({}, currentUser, fresh);

            const dashImg = document.getElementById('dashboard-avatar-img');
            if (dashImg) dashImg.src = avatarSrcFor(currentUser);

            const dashWrap = document.getElementById('dashboard-avatar');
            if (dashWrap && fresh && fresh.color) {
                dashWrap.className = `w-8 h-8 rounded-lg ${fresh.color} overflow-hidden`;
            }

            const msgImg = document.getElementById('messenger-avatar-img');
            if (msgImg) msgImg.src = avatarSrcFor(currentUser);

            const msgWrap = document.getElementById('messenger-avatar');
            if (msgWrap && fresh && fresh.color) {
                msgWrap.className = `w-7 h-7 rounded-lg ${fresh.color} overflow-hidden flex-shrink-0`;
            }
        }

        function refreshConversationHeader() {
            if (!activeConvo) return;
            const avatarEl = document.getElementById('chat-partner-avatar');
            if (!avatarEl) return;
            if (activeConvo.kind === 'dm') {
                const partner = getProfileById(activePartnerId);
                avatarEl.innerHTML = profileAvatarInner(partner);
                if (partner && partner.color) avatarEl.className = `rounded-xl ${partner.color} overflow-hidden flex-shrink-0`;
            } else {
                const g = getGroupById(activeConvo.id);
                avatarEl.innerHTML = g ? groupAvatarInner(g) : '';
            }
        }

        function renderProfiles() {
            const container = document.getElementById('profiles-container');
            container.innerHTML = '';

            profiles.forEach(profile => {
                const profileCard = document.createElement('div');
                profileCard.className = 'profile-card group cursor-pointer text-center relative';
                profileCard.onclick = () => handleProfileClick(profile);
                
                profileCard.innerHTML = `
                    <div class="profile-avatar w-24 h-24 md:w-36 md:h-36 rounded-md ${profile.color} flex items-center justify-center overflow-hidden relative">
                        <img src="${avatarSrcFor(profile)}" alt="${escapeHtml(profile.name)}" class="w-full h-full object-cover">
                        ${isManageMode ? `
                            <div class="absolute inset-0 bg-black/60 flex items-center justify-center">
                                <svg class="w-10 h-10 md:w-12 md:h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
                                </svg>
                            </div>
                        ` : ''}
                        ${profile.isKid ? '<span class="absolute bottom-1 right-1 text-xs bg-black/70 text-white px-1 rounded">KIDS</span>' : ''}
                        ${profile.pinHash && !isManageMode ? `
                            <span class="absolute top-1 right-1 bg-black/60 backdrop-blur-sm rounded-full p-1" title="PIN protected">
                                <svg class="w-3.5 h-3.5 text-white/90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                                </svg>
                            </span>
                        ` : ''}
                    </div>
                    <p class="profile-name mt-3 text-gray-400 text-sm md:text-lg">${profile.name}</p>
                `;
                
                container.appendChild(profileCard);
            });

            if (profiles.length < 5) {
                const addBtn = document.createElement('div');
                addBtn.className = 'profile-card group cursor-pointer text-center';
                addBtn.onclick = showAddProfile;
                addBtn.innerHTML = `
                    <div class="add-profile w-24 h-24 md:w-36 md:h-36 rounded-md flex items-center justify-center">
                        <svg class="w-16 h-16 md:w-24 md:h-24 text-gray-500 group-hover:text-gray-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 4v16m8-8H4"/>
                        </svg>
                    </div>
                    <p class="profile-name mt-3 text-gray-400 text-sm md:text-lg group-hover:text-white">Add Profile</p>
                `;
                container.appendChild(addBtn);
            }

            const title = document.getElementById('main-title');
            title.textContent = isManageMode ? 'Manage Profiles:' : "Who's watching?";
        }

        function handleProfileClick(profile) {
            if (isManageMode) {
                showEditProfile(profile);
            } else {
                // Every profile is PIN protected — ask for it first
                requestProfileAccess(profile);
            }
        }

        function selectProfile(profile) {
            currentUser = profile;
            const loadingScreen = document.getElementById('loading-screen');
            const loadingAvatar = document.getElementById('loading-avatar');
            const loadingName = document.getElementById('loading-name');

            loadingAvatar.className = `loading-avatar w-32 h-32 md:w-48 md:h-48 rounded-md flex items-center justify-center overflow-hidden mb-6 ${profile.color}`;
            loadingAvatar.innerHTML = `<img src="${avatarSrcFor(profile)}" alt="${escapeHtml(profile.name)}" class="w-full h-full object-cover">`;
            loadingName.textContent = profile.name;

            loadingScreen.classList.remove('opacity-0', 'pointer-events-none');
            loadingScreen.classList.add('opacity-100');

            setTimeout(() => {
                loadingScreen.classList.add('opacity-0', 'pointer-events-none');
                loadingScreen.classList.remove('opacity-100');
                showDashboard(profile);
            }, 1500);
        }

        function showDashboard(profile) {
            document.getElementById('dashboard-avatar').className = `w-8 h-8 rounded-lg ${profile.color} overflow-hidden`;
            document.getElementById('dashboard-avatar-img').src = avatarSrcFor(profile);
            document.getElementById('dashboard-username').textContent = profile.name;

            // Messenger header identity
            document.getElementById('messenger-avatar').className = `w-7 h-7 rounded-lg ${profile.color} overflow-hidden flex-shrink-0`;
            document.getElementById('messenger-avatar-img').src = avatarSrcFor(profile);
            document.getElementById('messenger-username').textContent = profile.name;

            const hour = new Date().getHours();
            let greeting = 'Good evening';
            if (hour < 12) greeting = 'Good morning';
            else if (hour < 18) greeting = 'Good afternoon';
            document.getElementById('welcome-text').textContent = `${greeting}, ${profile.name}`;

            loadUserData();
            notifBaselineDone = false;
            knownLastAt = {};
            loadNotifPrefs();
            // Returning user with permission already granted -> refresh this device's
            // push subscription (endpoints rotate). Silent no-op everywhere else.
            registerPushSubscription();
            startChatsListener();
            startCallListener();

            const dashboard = document.getElementById('dashboard-screen');
            const profilesScreen = document.getElementById('profiles-screen');
            
            profilesScreen.classList.add('opacity-0', 'pointer-events-none');
            dashboard.classList.remove('opacity-0', 'pointer-events-none');
            dashboard.classList.add('opacity-100');
        }

        function loadUserData() {
            if (!currentUser) return;

            const userDataRef = db.ref(`userData/${currentUser.id}`);
            
            userDataRef.on("value", snapshot => {
                const data = snapshot.val() || {};
                userData = {
                    files: data.files ? Object.entries(data.files).map(([id, val]) => ({id, ...val})) : [],
                    photos: data.photos ? Object.entries(data.photos).map(([id, val]) => ({id, ...val})) : [],
                    videos: data.videos ? Object.entries(data.videos).map(([id, val]) => ({id, ...val})) : [],
                    notes: data.notes ? Object.entries(data.notes).map(([id, val]) => ({id, ...val})) : []
                };
                updateDashboardCounts();
                updateRecentItems();
                if (currentSection) {
                    renderSectionContent();
                }
            });
        }

        function updateDashboardCounts() {
            document.getElementById('files-count').textContent = `${userData.files.length} files`;
            document.getElementById('photos-count').textContent = `${userData.photos.length} photos`;
            document.getElementById('videos-count').textContent = `${userData.videos.length} videos`;
            document.getElementById('notes-count').textContent = `${userData.notes.length} notes`;
            
            const totalItems = userData.files.length + userData.photos.length + userData.videos.length + userData.notes.length;
            document.getElementById('storage-used').textContent = `${totalItems} items`;
        }

        function updateRecentItems() {
            const allItems = [
                ...userData.files.map(f => ({...f, type: 'files'})),
                ...userData.photos.map(p => ({...p, type: 'photos'})),
                ...userData.videos.map(v => ({...v, type: 'videos'})),
                ...userData.notes.map(n => ({...n, type: 'notes'}))
            ].sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0)).slice(0, 6);

            const container = document.getElementById('recent-items');
            
            if (allItems.length === 0) {
                container.innerHTML = '<p class="text-white/30 col-span-full text-center py-8">No recent activity</p>';
                return;
            }

            container.innerHTML = allItems.map(item => {
                if (item.type === 'notes') {
                    return `
                        <div onclick="viewNote('${item.id}')" class="note-card rounded-xl p-4 cursor-pointer" style="background: ${item.color || '#fbbf24'}20; border: 1px solid ${item.color || '#fbbf24'}40">
                            <p class="text-white font-medium text-sm truncate mb-1">${item.title || 'Untitled'}</p>
                            <p class="text-white/50 text-xs line-clamp-2">${item.content || ''}</p>
                        </div>
                    `;
                } else if (item.type === 'photos') {
                    return `
                        <div onclick="viewPhoto('${item.id}')" class="content-card rounded-xl overflow-hidden cursor-pointer aspect-square bg-white/5">
                            <img src="${item.data}" class="w-full h-full object-cover">
                        </div>
                    `;
                } else if (item.type === 'videos') {
                    return `
                        <div onclick="viewVideo('${item.id}')" class="content-card rounded-xl overflow-hidden cursor-pointer aspect-square bg-white/5 relative video-thumb">
                            <video src="${item.data}" class="w-full h-full object-cover"></video>
                            <div class="absolute inset-0 flex items-center justify-center z-10">
                                <div class="w-10 h-10 rounded-full bg-white/20 backdrop-blur flex items-center justify-center">
                                    <svg class="w-5 h-5 text-white ml-0.5" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M8 5v14l11-7z"/>
                                    </svg>
                                </div>
                            </div>
                        </div>
                    `;
                } else {
                    return `
                        <div onclick="downloadFile('${item.id}')" class="content-card rounded-xl p-4 cursor-pointer bg-white/5 border border-white/10">
                            <div class="w-10 h-10 rounded-lg bg-blue-500/20 flex items-center justify-center mb-2">
                                <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                </svg>
                            </div>
                            <p class="text-white text-sm truncate">${item.name}</p>
                            <p class="text-white/40 text-xs">${formatFileSize(item.size)}</p>
                        </div>
                    `;
                }
            }).join('');
        }

        function goBackToProfiles() {
            const dashboard = document.getElementById('dashboard-screen');
            const profilesScreen = document.getElementById('profiles-screen');
            
            if (currentUser) {
                db.ref(`userData/${currentUser.id}`).off();
            }
            // Tear down messenger listeners
            closeMessenger(true);
            stopChatsListener();
            stopCallListener();
            
            dashboard.classList.add('opacity-0', 'pointer-events-none');
            dashboard.classList.remove('opacity-100');
            
            setTimeout(() => {
                profilesScreen.classList.remove('opacity-0', 'pointer-events-none');
            }, 300);
            
            currentUser = null;
            userData = { files: [], photos: [], videos: [], notes: [] };
        }

        function toggleUserMenu() {
            goBackToProfiles();
        }

        // Section Management
        function openSection(section) {
            currentSection = section;
            const panel = document.getElementById('content-panel');
            const titles = { files: 'Files', photos: 'Photos', videos: 'Videos', notes: 'Notes' };
            
            document.getElementById('section-title').textContent = titles[section];
            
            // Show/hide drop zone for file types
            const dropZone = document.getElementById('drop-zone');
            if (section !== 'notes') {
                dropZone.classList.remove('hidden');
            } else {
                dropZone.classList.add('hidden');
            }
            
            renderSectionContent();
            
            panel.classList.remove('opacity-0', 'pointer-events-none');
            panel.classList.add('opacity-100');
        }

        function closeSection() {
            const panel = document.getElementById('content-panel');
            panel.classList.add('opacity-0', 'pointer-events-none');
            panel.classList.remove('opacity-100');
            currentSection = null;
        }

        function renderSectionContent() {
            const grid = document.getElementById('content-grid');
            const emptyState = document.getElementById('empty-state');
            const items = userData[currentSection] || [];

            if (items.length === 0) {
                grid.classList.add('hidden');
                emptyState.classList.remove('hidden');
                updateEmptyState();
                return;
            }

            grid.classList.remove('hidden');
            emptyState.classList.add('hidden');

            if (currentSection === 'notes') {
                grid.innerHTML = items.map(note => `
                    <div class="note-card rounded-xl p-5 cursor-pointer relative group" style="background: ${note.color || '#fbbf24'}15; border: 1px solid ${note.color || '#fbbf24'}30">
                        <button onclick="event.stopPropagation(); showDeleteContentModal('${note.id}', 'notes')" class="absolute top-2 right-2 opacity-0 group-hover:opacity-100 transition-opacity p-1.5 rounded-lg hover:bg-white/10">
                            <svg class="w-4 h-4 text-white/50 hover:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                            </svg>
                        </button>
                        <div onclick="viewNote('${note.id}')">
                            <h3 class="text-white font-semibold mb-2 pr-6">${note.title || 'Untitled'}</h3>
                            <p class="text-white/60 text-sm line-clamp-4">${note.content || ''}</p>
                            <p class="text-white/30 text-xs mt-3">${formatDate(note.createdAt)}</p>
                        </div>
                    </div>
                `).join('');
            } else if (currentSection === 'photos') {
                grid.innerHTML = items.map(photo => `
                    <div class="content-card rounded-xl overflow-hidden cursor-pointer aspect-square bg-white/5 relative group">
                        <img src="${photo.data}" class="w-full h-full object-cover" onclick="viewPhoto('${photo.id}')">
                        <button onclick="event.stopPropagation(); showDeleteContentModal('${photo.id}', 'photos')" class="absolute top-2 right-2 opacity-0 group-hover:opacity-100 transition-opacity p-1.5 rounded-lg bg-black/50 hover:bg-red-500/80">
                            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                            </svg>
                        </button>
                        <div class="absolute bottom-0 left-0 right-0 p-2 bg-gradient-to-t from-black/70 to-transparent">
                            <p class="text-white text-sm truncate">${photo.name}</p>
                        </div>
                    </div>
                `).join('');
            } else if (currentSection === 'videos') {
                grid.innerHTML = items.map(video => `
                    <div class="content-card rounded-xl overflow-hidden cursor-pointer aspect-video bg-white/5 relative group video-thumb">
                        <video src="${video.data}" class="w-full h-full object-cover" onclick="viewVideo('${video.id}')"></video>
                        <div class="absolute inset-0 flex items-center justify-center z-10 pointer-events-none">
                            <div class="w-14 h-14 rounded-full bg-white/20 backdrop-blur flex items-center justify-center">
                                <svg class="w-7 h-7 text-white ml-1" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M8 5v14l11-7z"/>
                                </svg>
                            </div>
                        </div>
                        <button onclick="event.stopPropagation(); showDeleteContentModal('${video.id}', 'videos')" class="absolute top-2 right-2 opacity-0 group-hover:opacity-100 transition-opacity p-1.5 rounded-lg bg-black/50 hover:bg-red-500/80 z-20">
                            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                            </svg>
                        </button>
                        <div class="absolute bottom-0 left-0 right-0 p-2 bg-gradient-to-t from-black/70 to-transparent z-10">
                            <p class="text-white text-sm truncate">${video.name}</p>
                        </div>
                    </div>
                `).join('');
            } else {
                grid.innerHTML = items.map(file => `
                    <div class="content-card rounded-xl p-5 cursor-pointer bg-white/5 border border-white/10 relative group">
                        <button onclick="event.stopPropagation(); showDeleteContentModal('${file.id}', 'files')" class="absolute top-2 right-2 opacity-0 group-hover:opacity-100 transition-opacity p-1.5 rounded-lg hover:bg-white/10">
                            <svg class="w-4 h-4 text-white/50 hover:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                            </svg>
                        </button>
                        <div onclick="downloadFile('${file.id}')">
                            <div class="w-12 h-12 rounded-xl bg-blue-500/20 flex items-center justify-center mb-3">
                                <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                </svg>
                            </div>
                            <p class="text-white font-medium truncate pr-6">${file.name}</p>
                            <p class="text-white/40 text-sm">${formatFileSize(file.size)}</p>
                            <p class="text-white/30 text-xs mt-1">${formatDate(file.createdAt)}</p>
                        </div>
                    </div>
                `).join('');
            }
        }

        function updateEmptyState() {
            const icons = {
