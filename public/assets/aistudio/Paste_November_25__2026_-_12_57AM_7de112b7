        let notifAsked = false;   // have we shown the system permission prompt yet?

        async function toggleNotifications() {
            if (!currentUser) return;

            // First ever tap on a device that supports system notifications -> enable + ask,
            // instead of silently switching alerts off.
            const wantsEnable = !notifPrefs.inApp || (!notifAsked && notificationPermission() === 'default');

            if (!wantsEnable) {
                notifPrefs.inApp = false;
                saveNotifPrefs();
                showToast({ title: 'Notifications paused', text: 'You will not get new message alerts.', icon: 'bell-off' });
                return;
            }

            notifPrefs.inApp = true;
            saveNotifPrefs();
            unlockNotificationAudio();

            if (!systemNotificationsAvailable()) {
                // Typical inside a wrapped WebView app
                showToast({
                    title: 'Alerts on (in-app)',
                    text: 'This app can show alerts while it is open. Install the site in Chrome for background notifications.',
                    icon: 'bell'
                });
                return;
            }

            if (Notification.permission === 'default') {
                notifAsked = true;
                try {
                    const result = await Notification.requestPermission();
                    if (result === 'granted') {
                        showToast({ title: 'Notifications enabled', text: 'You will be alerted about new messages.', icon: 'bell' });
                        registerPushSubscription();
                    } else {
                        showToast({ title: 'Alerts on (in-app)', text: 'System notifications were blocked — alerts will still show inside the app.', icon: 'bell' });
                    }
                } catch (e) {
                    console.warn('Notification permission error:', e);
                }
            } else if (Notification.permission === 'granted') {
                showToast({ title: 'Notifications enabled', text: 'You will be alerted about new messages.', icon: 'bell' });
                registerPushSubscription();
            } else {
                showToast({ title: 'Alerts on (in-app)', text: 'System notifications are blocked in this browser. Enable them in site settings.', icon: 'bell' });
            }
        }

        /* ---------- sound ---------- */
        function unlockNotificationAudio() {
            if (notifAudioCtx) {
                if (notifAudioCtx.state === 'suspended') notifAudioCtx.resume().catch(() => {});
                return;
            }
            try {
                const Ctx = window.AudioContext || window.webkitAudioContext;
                if (Ctx) notifAudioCtx = new Ctx();
            } catch (e) { notifAudioCtx = null; }
        }

        function playNotificationSound() {
            if (!notifPrefs.sound) return;
            if (!notifAudioCtx) return;
            try {
                const ctx = notifAudioCtx;
                if (ctx.state === 'suspended') ctx.resume().catch(() => {});
                const now = ctx.currentTime;
                [0, 0.13].forEach((offset, i) => {
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(i === 0 ? 880 : 1180, now + offset);
                    gain.gain.setValueAtTime(0, now + offset);
                    gain.gain.linearRampToValueAtTime(0.08, now + offset + 0.01);
                    gain.gain.exponentialRampToValueAtTime(0.0001, now + offset + 0.16);
                    osc.connect(gain).connect(ctx.destination);
                    osc.start(now + offset);
                    osc.stop(now + offset + 0.18);
                });
            } catch (e) { /* audio is a nicety, never fatal */ }
        }

        function vibrateAlert() {
            try { if (navigator.vibrate) navigator.vibrate([40, 60, 40]); } catch (e) {}
        }

        /* ---------- in-app toast ---------- */
        function showToast(opts) {
            const stack = document.getElementById('notif-stack');
            if (!stack) return;

            const el = document.createElement('div');
            el.className = 'notif-toast';
            const avatarHtml = opts.avatarHtml || `
                <div class="notif-avatar" style="display:flex;align-items:center;justify-content:center;background:#4f46e5">
                    <svg style="width:18px;height:18px;color:#fff" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                    </svg>
                </div>`;

            el.innerHTML = `
                ${avatarHtml}
                <div class="notif-body">
                    <div class="notif-title">${escapeHtml(opts.title || 'Beyond Profiles')}</div>
                    <div class="notif-text">${escapeHtml(opts.text || '')}</div>
                </div>
                <span class="notif-time">${formatClockTime(Date.now())}</span>
            `;

            if (opts.onClick) {
                el.addEventListener('click', () => { opts.onClick(); dismiss(); });
            }

            const dismiss = () => {
                if (!el.parentNode) return;
                el.classList.add('leaving');
                setTimeout(() => { if (el.parentNode) el.parentNode.removeChild(el); }, 220);
            };

            stack.appendChild(el);
            // never stack more than 3
            while (stack.children.length > 3) stack.removeChild(stack.firstChild);
            setTimeout(dismiss, opts.duration || 4200);
        }

        /* ---------- system notification ---------- */
        async function showSystemNotification(title, body, target) {
            if (!systemNotificationsAvailable() || Notification.permission !== 'granted') return;
            try {
                const reg = await navigator.serviceWorker.getRegistration();
                const payload = {
