        function pinPress(digit) {
            if (!pinScreenOpen) return;
            if (pinState.lockedUntil > Date.now()) return;
            if (pinState.buffer.length >= PIN_LENGTH) return;
            pinState.buffer += digit;
            renderPinUI();
            if (pinState.buffer.length === PIN_LENGTH) {
                setTimeout(handlePinComplete, 120);
            }
        }

        function pinBackspace() {
            if (!pinScreenOpen) return;
            if (pinState.lockedUntil > Date.now()) return;
            pinState.buffer = pinState.buffer.slice(0, -1);
            renderPinUI();
        }

        function handlePinKeydown(e) {
            if (!pinScreenOpen) return;
            if (/^[0-9]$/.test(e.key)) {
                e.preventDefault();
                pinPress(e.key);
            } else if (e.key === 'Backspace') {
                e.preventDefault();
                pinBackspace();
            } else if (e.key === 'Escape') {
                e.preventDefault();
                closePinScreen();
            }
        }

        function handlePinComplete() {
            const entered = pinState.buffer;

            if (pinState.mode === 'verify') {
                verifyPin(entered);
            } else if (pinState.mode === 'set') {
                pinState.firstEntry = entered;
                pinState.buffer = '';
                pinState.mode = 'confirm';
                renderPinUI();
            } else if (pinState.mode === 'confirm') {
                if (entered === pinState.firstEntry) {
                    savePinForProfile(pinState.profile, entered);
                } else {
                    pinState.mode = 'set';
                    pinState.firstEntry = '';
                    pinState.buffer = '';
                    renderPinUI();
                    pinError('PINs did not match. Try again.');
                    shakePinCard();
                }
            }
        }

        function verifyPin(entered) {
            const profile = pinState.profile;
            if (!profile) return;

            const expected = profile.pinHash;
            const actual = hashPin(entered, profile.pinSalt || '');

            if (actual === expected) {
                clearInterval(pinLockTimer);
                pinLockTimer = null;
                const unlocked = profile;
                closePinScreen();
                selectProfile(unlocked);
                return;
            }

            pinState.attempts += 1;
            pinState.buffer = '';
            shakePinCard();

            if (pinState.attempts >= PIN_MAX_ATTEMPTS) {
                startPinLockout();
            } else {
                const left = PIN_MAX_ATTEMPTS - pinState.attempts;
                renderPinUI();
                pinError(`Incorrect PIN. ${left} attempt${left === 1 ? '' : 's'} left.`);
            }
        }

        function startPinLockout() {
            pinState.lockedUntil = Date.now() + PIN_LOCK_SECONDS * 1000;
            renderPinUI();
            clearInterval(pinLockTimer);

            const tick = () => {
                const remaining = Math.ceil((pinState.lockedUntil - Date.now()) / 1000);
                if (remaining > 0) {
                    pinError(`Too many attempts. Try again in ${remaining}s.`);
                    document.getElementById('pin-keypad').classList.add('pin-keypad-locked');
                } else {
                    clearInterval(pinLockTimer);
                    pinLockTimer = null;
                    pinState.attempts = 0;
                    pinState.buffer = '';
                    renderPinUI();
                }
            };
            tick();
            pinLockTimer = setInterval(tick, 250);
        }

        function pinError(message) {
            const el = document.getElementById('pin-error');
            if (el) el.textContent = message;
        }

        function shakePinCard() {
            const card = document.getElementById('pin-card');
            if (!card) return;
            card.classList.remove('pin-shake');
            void card.offsetWidth;
            card.classList.add('pin-shake');
            setTimeout(() => card.classList.remove('pin-shake'), 450);
        }

        function savePinForProfile(profile, pin) {
            if (!profile) return;
            const salt = makeSalt();
            const hash = hashPin(pin, salt);

            profilesRef.child(profile.id).update({
                pinHash: hash,
                pinSalt: salt,
                pinLength: PIN_LENGTH
            }).then(() => {
                // Keep the in-memory copy in sync so the unlock works immediately
                profile.pinHash = hash;
                profile.pinSalt = salt;
                profile.pinLength = PIN_LENGTH;
                closePinScreen();
                selectProfile(profile);
            }).catch(error => {
                console.error('PIN save error:', error);
                pinError('Could not save the PIN. Please try again.');
                shakePinCard();
            });
        }

