        // Drag and Drop
        function setupDragAndDrop() {
            const dropZones = ['drop-zone', 'upload-drop-zone'];
            
            dropZones.forEach(id => {
                const zone = document.getElementById(id);
                if (!zone) return;
                
                zone.addEventListener('dragover', (e) => {
                    e.preventDefault();
                    zone.classList.add('drag-over');
                });
                
                zone.addEventListener('dragleave', () => {
                    zone.classList.remove('drag-over');
                });
                
                zone.addEventListener('drop', (e) => {
                    e.preventDefault();
                    zone.classList.remove('drag-over');
                    
                    const files = e.dataTransfer.files;
                    if (files.length > 0) {
                        if (id === 'upload-drop-zone') {
                            document.getElementById('file-input').files = files;
                            handleFileSelect({ target: { files } });
                        } else {
                            // Direct upload from main drop zone
                            selectedFile = files[0];
                            showAddModal();
                            setTimeout(() => {
                                document.getElementById('file-input').files = files;
                                handleFileSelect({ target: { files } });
                            }, 100);
                        }
                    }
                });
            });
        }

        /* ============================================================
           NOTIFICATIONS
           Two layers, because a URL-wrapped Android app (WebView) has
           no Push API at all:
             1. In-app toasts + sound + vibration + tab badge  -> works
                everywhere, including inside AppsGeyser/WebView apps,
                while the app is open or in the background.
             2. System notifications / Web Push -> works when the site
                is opened in a real browser or installed as a PWA.
           ============================================================ */

        // Fill this in with your VAPID public key to enable background web push
        // (see NOTIFICATIONS_SETUP.md — requires a tiny sender function).
        const VAPID_PUBLIC_KEY = 'BCO9BCsxwF8CWhmJ-_3LUK9dM-kb9gvUfgKWPvfs1S4Q4HgXHMl3x1xZQJPxv-D0MvlFUVgL2QN2hrgGhcdoHhU';

        let notifPrefs = { inApp: true, sound: true };
        let notifAudioCtx = null;
        let notifBaselineDone = false;
        let knownLastAt = {};              // "kind:id" -> newest message ts we have reported on
        let pendingOpenTarget = null;       // "dm:<id>" / "group:<id>" to open after unlock

        function notifStorageKey() {
            return 'bp_notify_' + (currentUser ? currentUser.id : 'guest');
        }

        function loadNotifPrefs() {
            try {
                const raw = localStorage.getItem(notifStorageKey());
                if (raw) notifPrefs = Object.assign({ inApp: true, sound: true }, JSON.parse(raw));
            } catch (e) { /* storage blocked — defaults are fine */ }
            updateNotifButton();
        }

        function saveNotifPrefs() {
